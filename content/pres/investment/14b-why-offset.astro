---
import PresentationLayout from "@components/PresentationLayout.astro";
import offsetNetting from "./assets/svg/offset-netting.svg";
---

<PresentationLayout title="为什么能平仓离场" eyebrow="FUTURES · 期货三部曲 · WHY" narrow>
  <div class="slideRoot">
    <p class="lead">平仓 = 做一笔反向交易，买卖相抵后净额结算——自始至终没碰过一粒大豆。</p>

    <div class="mainGrid">
      <div class="statsCol">
        <div class="statGrid">
          <div class="statBox">
            <p class="statNumRed">&lt;2%</p>
            <p class="statLabel">合约真正走到<br/>实物交割</p>
          </div>
          <div class="statBox">
            <p class="statNumGreen">&gt;98%</p>
            <p class="statLabel">到期前已<br/>对冲平仓离场</p>
          </div>
        </div>
        <div class="reasonBox">
          <p class="reasonTitle">REASON · 为什么不用交割</p>
          <div class="reasonList">
            <div class="reasonItem">
              <span class="reasonNum">1.</span>
              <p class="reasonText">合约是一笔"义务"：买方有<span class="textGreen">买</span>的义务，卖方有<span class="textRed">卖</span>的义务</p>
            </div>
            <div class="reasonItem">
              <span class="reasonNum">2.</span>
              <p class="reasonText">到期前做一笔<span class="reasonTextBold">反向交易</span>，买卖义务恰好对消</p>
            </div>
            <div class="reasonItem">
              <span class="reasonNum">3.</span>
              <p class="reasonText">交易所<span class="reasonTextBold">净额结算</span>，只划转价差，货物从未易手</p>
            </div>
          </div>
        </div>
      </div>

      <div class="chartCard">
        <div class="chartHeader">
          <span class="chartTitle">OFFSET · 持仓相抵</span>
          <span class="chartMeta">净额结算</span>
        </div>
        <img src={offsetNetting.src} alt="期货买卖相抵只结算差额" class="fill" />
      </div>
    </div>

    <div class="footerBar">
      <p class="footerText"><strong>本质 ·</strong> 期货是一笔"可对消的义务"——反向一笔即归零，差额用现金了结，所以绝大多数合约从不交割实物。</p>
    </div>
  </div>
</PresentationLayout>

<style>
  /* ---- shared.layout: slideRoot ---- */
  .slideRoot {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.4rem 2.5rem 0.6rem;
    text-align: center;
  }

  /* ---- shared.shared: lead / chartCard / chartHeader / chartTitle / chartMeta / footerBar / footerText ---- */
  .lead {
    margin: 0;
    font-size: 1rem;
    color: #555;
  }

  .chartCard {
    min-height: 0;
    border: 1px solid #e2e2e2;
    background: #fafafa;
    padding: 0.6rem 0.8rem;
    display: flex;
    flex-direction: column;
  }

  .chartHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.2rem;
  }

  .chartTitle {
    font-size: 0.7rem;
    color: #9ca3af;
    font-family: 'Cascadia Code', monospace;
    letter-spacing: 0.08em;
  }

  .chartMeta {
    font-size: 0.65rem;
    color: #6b7280;
    font-family: 'Cascadia Code', monospace;
  }

  .footerBar {
    flex: 0 0 auto;
    border-left: 3px solid #333;
    padding: 0.6rem 1rem;
    background: #fafafa;
    width: 100%;
  }

  .footerText {
    margin: 0;
    font-size: 0.9rem;
    color: #333;
    line-height: 1.55;
  }

  /* ---- shared.slide-svg: fill ---- */
  .fill {
    width: 100%;
    flex: 1;
    min-height: 0;
    object-fit: contain;
  }

  /* ---- page-specific ---- */
  .mainGrid {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: grid;
    grid-template-columns: 2.5fr 7.5fr;
    gap: 1.1rem;
  }

  /* Left stats column */
  .statsCol {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  /* Two stat boxes */
  .statGrid {
    flex: 0 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .statBox {
    border: 1px solid #e2e2e2;
    background: #fafafa;
    padding: 0.7rem;
    text-align: center;
  }

  .statNumRed {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 800;
    color: #b91c1c;
    font-family: 'Cascadia Code', monospace;
  }

  .statNumGreen {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 800;
    color: #16a34a;
    font-family: 'Cascadia Code', monospace;
  }

  .statLabel {
    margin: 0.2rem 0 0;
    font-size: 0.7rem;
    color: #6b7280;
  }

  /* Reason box */
  .reasonBox {
    flex: 1;
    min-height: 0;
    border: 1px solid #e2e2e2;
    background: #fafafa;
    padding: 0.8rem 1.1rem;
    text-align: left;
  }

  .reasonTitle {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: #9ca3af;
    font-family: 'Cascadia Code', monospace;
  }

  .reasonList {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .reasonItem {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .reasonNum {
    color: #b91c1c;
    font-weight: 800;
    font-family: 'Cascadia Code', monospace;
    flex-shrink: 0;
  }

  .reasonText {
    margin: 0;
    font-size: 0.85rem;
    color: #444;
    line-height: 1.55;
  }

  .textGreen {
    color: #16a34a;
  }

  .textRed {
    color: #dc2626;
  }

  .reasonTextBold {
    color: #b91c1c;
    font-weight: 700;
  }
</style>