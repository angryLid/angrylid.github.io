---
import PresentationLayout from "@components/PresentationLayout.astro";
import layoutSvg from "./assets/svg/settling-predecessor.svg";
---

<PresentationLayout
  eyebrow="国企特别风险"
  title="清算前任 · 财报重算"
  narrow
>
  <div class="root">
    <div class="mainGrid">
      <div class="leftCol">
        <div class="card cardBad">
          <span class="cardIcon">⚖️</span>
          <div>
            <p class="cardTitle">触发 · 前任落马、权力真空</p>
            <p class="cardDesc">2025 前董事长李曙光被查；2026.2.28 董事长曾从钦被留置，班子代行职权——但无人愿为前任留下的账目签字背书</p>
          </div>
        </div>

        <div class="card cardPurple">
          <span class="cardIcon">📄</span>
          <div>
            <p class="cardTitle">动作 · 4.30 法定披露截止日"前期差错更正"</p>
            <p class="cardDesc">营收 609.45 → 306.38 亿（-303），归母净利 215.11 → 64.75 亿（-150），一次性剔除历史激进压货的虚高成分</p>
          </div>
        </div>

        <div class="card cardNeutral">
          <span class="cardIcon">🔍</span>
          <div>
            <p class="cardTitle">实质 · 收紧收入确认、切割前任责任</p>
            <p class="cardDesc">收入改为终端动销后再确认，切断前任连带责任，并砸出超低基数 → 2026 Q1 净利 +82.57%</p>
          </div>
        </div>
      </div>

      <div class="rightCol">
        <img src={layoutSvg.src} alt="五粮液财报前期差错更正" class="svg" />
      </div>
    </div>

    <div class="footer footerNeutral">
      <p class="footerText footerTextNeutral">
        <strong>总结：</strong>前任落马 → 财报"重算" → 股价承压 + 集体诉讼 + 监管立案——历史虚高业绩被一次性归零，分红预期与估值锚被打破。
      </p>
    </div>
  </div>
</PresentationLayout>

<style>
  /* ---- shared.divided-stocks: root / mainGrid / leftCol ---- */
  .root {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .mainGrid {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 1.6rem;
  }

  .leftCol {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
  }

  /* ---- shared.divided-stocks: card ---- */
  .card {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 0.85rem 1.1rem;
    border-left: 4px solid;
  }

  .cardGood {
    background: #fef2f2;
    border-left-color: #c0392b;
  }
  .cardGood .cardTitle {
    color: #991b1b;
  }

  .cardBad {
    background: #fff7ed;
    border-left-color: #ea580c;
  }
  .cardBad .cardTitle {
    color: #9a3412;
  }

  .cardMixed {
    background: #f8fafc;
    border-left-color: #dc2626;
  }
  .cardMixed .cardTitle {
    color: #334155;
  }

  .cardRed {
    background: #fef2f2;
    border-left-color: #dc2626;
  }
  .cardRed .cardTitle {
    color: #991b1b;
  }

  .cardAmber {
    background: #fffbeb;
    border-left-color: #ea580c;
  }
  .cardAmber .cardTitle {
    color: #9a3412;
  }

  .cardNeutral {
    background: #f8fafc;
    border-left-color: #cbd5e1;
  }
  .cardNeutral .cardTitle {
    color: #334155;
  }

  .cardPurple {
    background: #f5f3ff;
    border-left-color: #6d28d9;
  }
  .cardPurple .cardTitle {
    color: #5b21b6;
  }

  .cardIcon {
    font-size: 1.3rem;
  }

  .cardTitle {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }

  .cardDesc {
    font-size: 0.9rem;
    color: #555;
    margin: 0.2rem 0 0 0;
    line-height: 1.5;
  }

  /* ---- shared.divided-stocks: rightCol / svg ---- */
  .rightCol {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .svg {
    width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* ---- shared.divided-stocks: footer ---- */
  .footer {
    margin-top: 1rem;
    padding: 0.75rem 1.2rem;
    flex-shrink: 0;
  }

  .footerGreen {
    background: #f0fdf4;
    border-left: 4px solid #27ae60;
  }

  .footerRed {
    background: #f8fafc;
    border-left: 4px solid #dc2626;
  }

  .footerBlue {
    background: #eff6ff;
    border-left: 4px solid #2563eb;
  }

  .footerNeutral {
    background: #f8fafc;
    border-left: 4px solid #cbd5e1;
  }

  .footerText {
    font-size: 0.95rem;
    margin: 0;
  }

  .footerTextGreen {
    color: #166534;
  }

  .footerTextRed {
    color: #334155;
  }

  .footerTextBlue {
    color: #1e40af;
  }

  .footerTextNeutral {
    color: #334155;
  }
</style>