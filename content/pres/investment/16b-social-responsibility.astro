---
import PresentationLayout from "@components/PresentationLayout.astro";
import layoutSvg from "./assets/svg/social-responsibility.svg";
---

<PresentationLayout
  eyebrow="国家队的盘外招 · 其二"
  title="民生工程与社会责任"
  narrow
>
  <div class="root">
    <div class="mainGrid">
      <div class="leftCol">
        <div class="card cardMixed">
          <span class="cardIcon">🚢</span>
          <div>
            <p class="cardTitle">长江电力 · 葛洲坝船闸</p>
            <p class="cardDesc">2025.8 拟砸 266 亿建葛洲坝航运扩能（公益基建），5.7 亿股反对，仍 96% 强行通过</p>
          </div>
        </div>

        <div class="card cardGood">
          <span class="cardIcon">⚡</span>
          <div>
            <p class="cardTitle">火电厂 · 2021 亏本供电</p>
            <p class="cardDesc">煤价 600→2000 元/吨，电价锁死，发电即倒贴 2-3 毛/度；华能国际巨亏 100 亿+</p>
          </div>
        </div>

        <div class="card cardBad">
          <span class="cardIcon">⚖️</span>
          <div>
            <p class="cardTitle">市场化的成本 vs 行政化的公益</p>
            <p class="cardDesc">分红归零、戴维斯双杀；"讲政治、保民生"永远高于利润</p>
          </div>
        </div>
      </div>

      <div class="rightCol">
        <img src={layoutSvg.src} alt="长江电力与火电厂承担社会公益成本" class="svg" />
      </div>
    </div>

    <div class="footer footerRed">
      <p class="footerText footerTextRed">
        <strong>总结：</strong>在民生红线面前，市场化的成本必须给行政化的公益让路——上市公司替国家扛下保供保民生的账。
      </p>
    </div>
  </div>
</PresentationLayout>

<style>
  /* ---- shared.divided-stocks: root / mainGrid / leftCol ---- */
  .root {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .mainGrid {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 1.6rem;
  }

  .leftCol {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
  }

  /* ---- shared.divided-stocks: card ---- */
  .card {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 0.85rem 1.1rem;
    border-left: 4px solid;
  }

  .cardGood {
    background: #fef2f2;
    border-left-color: #c0392b;
  }
  .cardGood .cardTitle {
    color: #991b1b;
  }

  .cardBad {
    background: #fff7ed;
    border-left-color: #ea580c;
  }
  .cardBad .cardTitle {
    color: #9a3412;
  }

  .cardMixed {
    background: #f8fafc;
    border-left-color: #dc2626;
  }
  .cardMixed .cardTitle {
    color: #334155;
  }

  .cardRed {
    background: #fef2f2;
    border-left-color: #dc2626;
  }
  .cardRed .cardTitle {
    color: #991b1b;
  }

  .cardAmber {
    background: #fffbeb;
    border-left-color: #ea580c;
  }
  .cardAmber .cardTitle {
    color: #9a3412;
  }

  .cardNeutral {
    background: #f8fafc;
    border-left-color: #cbd5e1;
  }
  .cardNeutral .cardTitle {
    color: #334155;
  }

  .cardPurple {
    background: #f5f3ff;
    border-left-color: #6d28d9;
  }
  .cardPurple .cardTitle {
    color: #5b21b6;
  }

  .cardIcon {
    font-size: 1.3rem;
  }

  .cardTitle {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }

  .cardDesc {
    font-size: 0.9rem;
    color: #555;
    margin: 0.2rem 0 0 0;
    line-height: 1.5;
  }

  /* ---- shared.divided-stocks: rightCol / svg ---- */
  .rightCol {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .svg {
    width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* ---- shared.divided-stocks: footer ---- */
  .footer {
    margin-top: 1rem;
    padding: 0.75rem 1.2rem;
    flex-shrink: 0;
  }

  .footerGreen {
    background: #f0fdf4;
    border-left: 4px solid #27ae60;
  }

  .footerRed {
    background: #f8fafc;
    border-left: 4px solid #dc2626;
  }

  .footerBlue {
    background: #eff6ff;
    border-left: 4px solid #2563eb;
  }

  .footerNeutral {
    background: #f8fafc;
    border-left: 4px solid #cbd5e1;
  }

  .footerText {
    font-size: 0.95rem;
    margin: 0;
  }

  .footerTextGreen {
    color: #166534;
  }

  .footerTextRed {
    color: #334155;
  }

  .footerTextBlue {
    color: #1e40af;
  }

  .footerTextNeutral {
    color: #334155;
  }
</style>