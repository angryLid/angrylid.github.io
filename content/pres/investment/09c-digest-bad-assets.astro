---
import PresentationLayout from "@components/PresentationLayout.astro";
import cashCowHorse from "./assets/svg/cash-cow-horse.svg";
---

<PresentationLayout
  eyebrow="国家队的盘外招 · 其一"
  title="消化不良资产"
  narrow
>
  <div class="root">
    <div class="mainGrid">
      <div class="leftCol">
        <div class="card cardGood">
          <span class="cardIcon">💎</span>
          <div>
            <p class="cardTitle">大秦线 · 核心盈利资产</p>
            <p class="cardDesc">全球最暴利的重载煤运专线，现金流长期稳定充沛</p>
          </div>
        </div>
        <div class="card cardBad">
          <span class="cardIcon">📦</span>
          <div>
            <p class="cardTitle">大秦铁路 · 被注入低效资产</p>
            <p class="cardDesc">2009 年 165 亿定增，反向收购太原局 7 条干线 + 5 条支线（普速客运常年亏损）</p>
          </div>
        </div>
        <div class="card cardMixed">
          <span class="cardIcon">📉</span>
          <div>
            <p class="cardTitle">优质资产 · 被低效包袱拖累</p>
            <p class="cardDesc">百亿客运收入却公益亏损，ROE 与分红被稀释；京沪高铁亦被注入 500 亿京福安徽</p>
          </div>
        </div>
      </div>
      <div class="rightCol">
        <img src={cashCowHorse.src} alt="神马拉一车砖头，优质资产被低效资产拖累" class="svg" />
      </div>
    </div>
    <div class="footer footerGreen">
      <p class="footerText footerTextGreen"><strong>总结：</strong>大股东把低效亏损资产高价打包注入上市公司，用优质资产的收益填补低效资产的亏损，稀释原有股东回报。</p>
    </div>
  </div>
</PresentationLayout>

<style>
  /* ---- shared.divided-stocks: root ---- */
  .root {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* ---- shared.divided-stocks: mainGrid ---- */
  .mainGrid {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 1.6rem;
  }

  /* ---- shared.divided-stocks: leftCol ---- */
  .leftCol {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
  }

  /* ---- shared.divided-stocks: card ---- */
  .card {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 0.85rem 1.1rem;
    border-left: 4px solid;
  }

  .cardGood {
    background: #fef2f2;
    border-left-color: #c0392b;
  }
  .cardGood .cardTitle {
    color: #991b1b;
  }

  .cardBad {
    background: #fff7ed;
    border-left-color: #ea580c;
  }
  .cardBad .cardTitle {
    color: #9a3412;
  }

  .cardMixed {
    background: #f8fafc;
    border-left-color: #dc2626;
  }
  .cardMixed .cardTitle {
    color: #334155;
  }

  /* ---- shared.divided-stocks: card (unused variants retained for completeness) ---- */
  .cardRed {
    background: #fef2f2;
    border-left-color: #dc2626;
  }
  .cardRed .cardTitle {
    color: #991b1b;
  }

  .cardAmber {
    background: #fffbeb;
    border-left-color: #ea580c;
  }
  .cardAmber .cardTitle {
    color: #9a3412;
  }

  .cardNeutral {
    background: #f8fafc;
    border-left-color: #cbd5e1;
  }
  .cardNeutral .cardTitle {
    color: #334155;
  }

  .cardPurple {
    background: #f5f3ff;
    border-left-color: #6d28d9;
  }
  .cardPurple .cardTitle {
    color: #5b21b6;
  }

  .cardIcon {
    font-size: 1.3rem;
  }

  .cardTitle {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }

  .cardDesc {
    font-size: 0.9rem;
    color: #555;
    margin: 0.2rem 0 0 0;
    line-height: 1.5;
  }

  /* ---- shared.divided-stocks: rightCol / svg ---- */
  .rightCol {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .svg {
    width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* ---- shared.divided-stocks: footer ---- */
  .footer {
    margin-top: 1rem;
    padding: 0.75rem 1.2rem;
    flex-shrink: 0;
  }

  .footerGreen {
    background: #f0fdf4;
    border-left: 4px solid #27ae60;
  }

  .footerRed {
    background: #f8fafc;
    border-left: 4px solid #dc2626;
  }

  .footerBlue {
    background: #eff6ff;
    border-left: 4px solid #2563eb;
  }

  .footerNeutral {
    background: #f8fafc;
    border-left: 4px solid #cbd5e1;
  }

  .footerText {
    font-size: 0.95rem;
    margin: 0;
  }

  .footerTextGreen {
    color: #166534;
  }

  .footerTextRed {
    color: #334155;
  }

  .footerTextBlue {
    color: #1e40af;
  }

  .footerTextNeutral {
    color: #334155;
  }
</style>