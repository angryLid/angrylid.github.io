---
import PresentationLayout from "@components/PresentationLayout.astro";
---

<PresentationLayout title="黄金 — 为什么是它？" eyebrow="共识类资产" narrow>
  <div class="root">
    {/* 左侧：四个筛选条件 */}
    <div class="leftCol">
      <p class="intro">一轮一轮筛选下来，只剩黄金了 ↓</p>

      {/* 条件 1 */}
      <div class="critCard">
        <div class="critBody">
          <div class="critLine">
            <span class="critCheck">✓</span>
            <strong class="critStrong">化学性质极其稳定</strong>
            <span class="critHint">不氧化 · 不腐烂 · 千年不变质</span>
          </div>
          <p class="critReject">
            <span class="critCross">✗</span>
            香烟虽可视作硬通货，却难以长期储存
          </p>
        </div>
      </div>

      {/* 条件 2 */}
      <div class="critCard">
        <div class="critBody">
          <div class="critLine">
            <span class="critCheck">✓</span>
            <strong class="critStrong">矿脉分布广泛</strong>
            <span class="critHint">全球各大陆都有产出</span>
          </div>
          <p class="critReject">
            <span class="critCross">✗</span>
            铂、钯几乎全部集中于南非与俄罗斯
          </p>
        </div>
      </div>

      {/* 条件 3 */}
      <div class="critCard">
        <div class="critBody">
          <div class="critLine">
            <span class="critCheck">✓</span>
            <strong class="critStrong">储量稀缺且有限</strong>
            <span class="critHint">天然稀有 · 几乎无法人工合成</span>
          </div>
          <p class="critReject">
            <span class="critCross">✗</span>
            白银储量过大；
          </p>
        </div>
      </div>

      {/* 条件 4 */}
      <div class="critCard">
        <div class="critBody">
          <div class="critLine">
            <span class="critCheck">✓</span>
            <strong class="critStrong">同质化 · 易分割</strong>
            <span class="critHint">每克都一样 · 按重量计价</span>
          </div>
          <p class="critReject">
            <span class="critCross">✗</span>
            宝石一经切割即贬值，难以分割计价
          </p>
        </div>
      </div>

      {/* 底部结论 */}
      <div class="goldConclusion">
        因此不同文明在历史上不约而同地选择了黄金作为货币。
        <br />
        <span class="goldConclusionNote">
          （金本位暴露出的问题，此处不作展开）
        </span>
      </div>
    </div>

    {/* 右侧：元素周期表样式方格 */}
    <div class="rightCol">
      {/* 元素方格 */}
      <div class="tile">
        {/* 原子序数（左上） */}
        <div class="tileAtomic">79</div>

        {/* 元素符号（绝对居中） */}
        <div class="tileSymbol">Au</div>

        {/* 底部：相对原子质量（左）+ 电子层排布（右下角） */}
        <div class="tileFooter">
          <div class="tileMass">196.97</div>
          <div class="tileShells">
            <div>K 2</div>
            <div>L 8</div>
            <div>M 18</div>
            <div>N 32</div>
            <div>O 18</div>
            <div>P 1</div>
          </div>
        </div>
      </div>

      <p class="tileCaption">
        四种物理特性<br />
        让它成为<strong class="tileCaptionStrong">天然的货币金属</strong>
      </p>
    </div>
  </div>
</PresentationLayout>

<style>
  .root {
    height: 100%;
    display: grid;
    grid-template-columns: auto 280px;
    justify-content: center;
    gap: 3rem;
    align-items: center;
  }

  /* Left: filter criteria */
  .leftCol {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: fit-content;
  }

  .intro {
    margin: 0 0 0.2rem 0;
    font-size: 1.37rem;
    font-weight: 600;
    color: #444;
  }

  /* A criterion card */
  .critCard {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.65rem 1.1rem;
    background: #fafaf7;
    border-left: 4px solid #d4af37;
  }

  .critBody {
    flex: 1;
  }

  .critLine {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .critCheck {
    font-size: 1.44rem;
    color: #b8860b;
    flex-shrink: 0;
  }

  .critStrong {
    font-size: 1.44rem;
    color: #333;
  }

  .critHint {
    font-size: 1.18rem;
    color: #999;
  }

  .critReject {
    margin: 0.2rem 0 0 0;
    font-size: 1.18rem;
    color: #888;
  }

  .critCross {
    color: #bbb;
    margin-right: 0.3rem;
  }

  /* Bottom conclusion */
  .goldConclusion {
    margin-top: 0.1rem;
    padding: 0.4rem 1.1rem;
    text-align: left;
    font-size: 1.22rem;
    color: #777;
    font-style: italic;
  }

  .goldConclusionNote {
    font-size: 1.13rem;
    color: #aaa;
  }

  /* Right: periodic-table tile */
  .rightCol {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Element tile */
  .tile {
    position: relative;
    width: 190px;
    height: 190px;
    background: #f9e07a;
    border: 2px solid #b8860b;
    padding: 0.9rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .tileAtomic {
    font-size: 1.4rem;
    font-weight: 700;
    color: #5c3d0a;
    line-height: 1;
  }

  .tileSymbol {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    font-weight: 800;
    color: #8a6a12;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .tileFooter {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .tileMass {
    font-size: 0.85rem;
    color: #5c3d0a;
    line-height: 1.4;
    font-weight: 500;
  }

  .tileShells {
    font-size: 0.72rem;
    color: #6b5220;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-align: right;
  }

  .tileCaption {
    margin: 0;
    font-size: 0.95rem;
    color: #666;
    text-align: center;
    line-height: 1.6;
  }

  .tileCaptionStrong {
    color: #b8860b;
  }
</style>