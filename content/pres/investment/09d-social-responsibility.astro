---
import PresentationLayout from "@components/PresentationLayout.astro";
import shareholdersCarryingLock from "./assets/svg/shareholders-carrying-lock.svg";
import shareholdersBurningMoney from "./assets/svg/shareholders-burning-money.svg";
---

<PresentationLayout
  eyebrow="国家队的盘外招 · 其二"
  title="民生工程与社会责任"
  narrow
>
  <div class="root">
    <div class="mainGrid">
      <img src={shareholdersBurningMoney.src} alt="多名头戴“股民”头巾的人往燃烧的锅炉里塞钞票" class="svg imgBoiler" />
      <div class="caption capBoiler">
        <p class="captionTitle">火电厂 · 亏本保供（2021）</p>
        <p class="captionLine">煤价疯涨，一度电倒贴 2-3 毛</p>
        <p class="captionSub">保供死命令下不许停机，合计亏损超 460 亿</p>
      </div>
      <div class="caption capLock">
        <p class="captionTitle">长江电力 · 葛洲坝扩建（2025）</p>
        <p class="captionLine">266亿“公益项目”</p>
        <p class="captionSub">96.02% 赞成率强行通过</p>
      </div>
      <img src={shareholdersCarryingLock.src} alt="多名头戴“股民”头巾的人肩扛着一座船闸" class="svg imgLock" />
    </div>
  </div>
</PresentationLayout>

<style>
  .root {
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .mainGrid {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 0.9rem 1.6rem;
  }

  /* boiler image: column 1, rows 1-2 */
  .imgBoiler {
    grid-area: 2 / 1 / 4 / 2;
    align-self: center;
  }

  /* boiler caption: column 2, row 1 */
  .capBoiler {
    grid-area: 1 / 1 / 2 / 2;
    align-self: center;
  }

  /* lock image: column 2, rows 2-3 */
  .imgLock {
    grid-area: 1 / 2 / 3 / 3;
    align-self: end;
  }

  /* lock caption: column 1, row 3 */
  .capLock {
    grid-area: 3 / 2 / 4 / 3;
    align-self: end;
  }

  .svg {
    display: block;
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .caption {
    flex: none;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-border);
    background: #f8fafc;
  }

  /* hydropower story: blue tones */
  .capLock {
    background: #eff6ff;
    --color-border: #1f4e79; 
  }

  .capLock .captionTitle,
  .capLock .captionLine,
  .capLock .captionSub {
    color: #1f4e79;
  }

  /* thermal power story: black + red tones */
  .capBoiler {
    background: #fdf0ee;
    --color-border: #c0392b;
  }

  .capBoiler .captionTitle,
  .capBoiler .captionLine,
  .capBoiler .captionSub {
    color: #1a1a1a;
  }

  /* all three lines share the middle line's size and color; only weight differs */
  .captionTitle {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .captionLine {
    margin: 0.2rem 0 0;
    font-size: 1.05rem;
    font-weight: 400;
  }

  .captionSub {
    margin: 0.2rem 0 0;
    font-size: 1.05rem;
    font-weight: 400;
  }
</style>
