---
// ============================================================================
// /pres/[slug]/document/ — "presentation as document" page
// ============================================================================
// Renders the whole deck as a single scrolling page (every slide as a 16:9
// scaled preview with a title header and its speaker notes below).
//
// WHY A DEDICATED PAGE
// --------------------
// This must be a *page* (under src/pages/**), NOT a component nested inside a
// blog post. Astro only collects/bundles the scoped <style> of a
// content-collection entry when it is rendered from a page. If the slides were
// rendered from a component that is itself nested inside another MDX entry,
// every .astro component the slides import would silently lose its styles
// (withastro/astro#6121, withastro/astro#7761).
//
// Because this is a page, Astro bundles all the slide component styles here —
// exactly like presenter.astro and the per-slide pages already do. The blog
// post then simply embeds this URL in a lazy-loading <iframe> (see
// PresAsPost.astro). That completely sidesteps the limitation.
// ============================================================================
import { type CollectionEntry, render } from "astro:content";
import PresHead from "@components/PresHead.astro";
import SlideFrame from "@components/SlideFrame.astro";
import { getPresDecks } from "@utils/pres";

export async function getStaticPaths() {
  const decks = await getPresDecks();
  return decks.map(({ slug, slides }) => ({
    params: { slug },
    props: { slug, slides },
  }));
}

interface Props {
  slug: string;
  slides: CollectionEntry<"pres">[];
}

const { slug, slides } = Astro.props;
const presTitle = slides[0].data.presTitle || slug;

const rendered = await Promise.all(
  slides.map(async (entry) => {
    const { Content } = await render(entry);
    return { Content, title: entry.data.title };
  }),
);
---

<!doctype html>
<html lang="zh-CN">
  <PresHead title={`${presTitle} — 演示文稿`} />

  <body>
    <!-- Scoped page structure. Every class below is an element of THIS component's
         own template, so Astro scopes it with a data-astro-cid attribute. Scoping
         guarantees these class names (.page-head, .slide-block, .notes-block, …)
         can never leak into — or clash with — the rendered slide <Content />, which
         keeps its own component-scope attributes. The :global() wrappers on the
         selectors that must actually reach into <Content /> (heading typography,
         note-content styling) opt only those specific rules out of scoping. -->
    <style>
      :global(body) {
        min-height: 100vh;
      }

      /* ---- page container ---- */
      .document-wrap {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }

      /* ---- page header ---- */
      .page-head {
        margin-bottom: 2rem;
        text-align: center;
      }
      .page-head h1 {
        font-size: 1.8rem;
        color: var(--dark-mint);
      }
      .page-head .fresh-link {
        display: inline-block;
        margin-top: 0.5rem;
        font-size: 0.9rem;
        color: var(--dark-mint);
        text-decoration: none;
      }
      .page-head .fresh-link:hover {
        text-decoration: underline;
      }

      /* ---- scaled slide preview (faithful 1280×720 miniature) ---- */
      .slide-block {
        margin-bottom: 3rem;
        border-top: 1px solid #e0e0d8;
        padding-top: 1.5rem;
      }
      .slide-block:first-of-type {
        border-top: none;
        padding-top: 0;
      }
      .slide-block-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.75rem;
      }
      .slide-no {
        font-size: 1.25rem;
        color: var(--dark-mint);
      }
      .slide-link {
        font-size: 0.85rem;
        color: var(--gray);
        text-decoration: none;
        white-space: nowrap;
      }
      .slide-link:hover {
        color: var(--dark-mint);
        text-decoration: underline;
      }

      /* Base preview markup/CSS/scaling come from the shared <SlideFrame
         data-fit="width"> component. Only the document-specific frame
         (border + radius) is added here via :global so it reaches the
         component's stage element. */
      :global(.preview-stage) {
        border-radius: var(--border-radius);
        border: 1px solid #e0e0d8;
      }

      /* Reach into the rendered slide <Content /> to mirror presentation-mode
         heading typography. The heading color now comes from the shared base
         (.slide :is(h1..h6)); only the border reset is specific to the scroll
         context. */
      :global(.preview-inner :is(h1, h2, h3, h4, h5, h6)) {
        border-bottom: none;
      }

      /* ---- speaker notes ---- */
      .notes-block {
        margin-top: 1rem;
        padding: 1rem 1.25rem;
        background: var(--white);
        border-left: 3px solid var(--dark-mint);
        border-radius: 4px;
        font-size: 0.95rem;
        line-height: 1.7;
        color: var(--gray);
      }
      .notes-block:empty {
        display: none;
      }
      /* The note body is cloned from the <template> inside <Content />, so its
         children are NOT in this component's scope — target them with :global(). */
      .notes-block :global(:is(h1, h2, h3)) {
        color: var(--dark-mint);
        margin: 0.4em 0;
        font-size: 1em;
      }
      .notes-block :global(:is(ul, ol)) {
        margin: 0.4em 0 0.4em 1.5em;
      }
      .notes-block :global(p) {
        margin: 0.4em 0;
      }
    </style>

    <div class="document-wrap">
      <header class="page-head">
        <h1>{presTitle}</h1>
        <a class="fresh-link" href={`/pres/${slug}/live/1/`}>进入演示模式 →</a>
      </header>

      {
        rendered.map(({ Content, title }, idx) => (
          <section class="slide-block">
            <header class="slide-block-head">
              <h2 class="slide-no">
                {idx + 1}. {title}
              </h2>
              <a class="slide-link" href={`/pres/${slug}/live/${idx + 1}/`}>
                幻灯片 {idx + 1} ↗
              </a>
            </header>
            <SlideFrame fit="width">
              <Content />
            </SlideFrame>
            <div class="notes-block" data-notes />
          </section>
        ))
      }
    </div>

    <script is:inline>
      // Extract speaker notes from each slide's <template> and render them
      // visibly, and mark every data-anim element as data-visible so stepped
      // content (fly/blinds animations) renders in its final state in this
      // scroll context. is:inline runs synchronously during parse (before
      // paint), so notes appear without a flash.
      (function () {
        document
          .querySelectorAll(".slide-block:not([data-notes-done])")
          .forEach(function (block) {
            var tpl = block.querySelector("template.speaker-notes");
            var notes = block.querySelector("[data-notes]");
            if (tpl && notes) {
              notes.append(tpl.content.cloneNode(true));
            }
            block.setAttribute("data-notes-done", "");
          });
        // All animation steps are shown at once in the scroll context.
        document.querySelectorAll("[data-anim]").forEach(function (el) {
          el.setAttribute("data-visible", "");
        });
      })();
    </script>
  </body>
</html>