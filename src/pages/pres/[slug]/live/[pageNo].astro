---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Presentation from "@layouts/Presentation.astro";

export async function getStaticPaths() {
  const entries = await getCollection("pres");

  // Group by slug = first segment of entry.id
  // (id for content/pres/demo/01-title.mdx === "demo/01-title")
  const bySlug = new Map<string, CollectionEntry<"pres">[]>();
  for (const entry of entries) {
    const slug = entry.id.split("/")[0];
    if (!bySlug.has(slug)) bySlug.set(slug, []);
    bySlug.get(slug)!.push(entry);
  }

  const paths: {
    params: { slug: string; pageNo: string };
    props: {
      slug: string;
      pageNo: number;
      total: number;
      presTitle: string;
      slideEntries: CollectionEntry<"pres">[];
    };
  }[] = [];

  for (const [slug, group] of bySlug) {
    // Sort lexicographically by id — hence the 01-, 02- naming convention.
    group.sort((a, b) => a.id.localeCompare(b.id));
    const total = group.length;
    const presTitle = group[0].data.presTitle || slug;
    group.forEach((_entry, idx) => {
      paths.push({
        params: { slug, pageNo: String(idx + 1) },
        props: { slug, pageNo: idx + 1, total, presTitle, slideEntries: group },
      });
    });
  }
  return paths;
}

interface Props {
  slug: string;
  pageNo: number;
  total: number;
  presTitle: string;
  slideEntries: CollectionEntry<"pres">[];
}

const { slug, pageNo, total, presTitle, slideEntries } = Astro.props;

// Render every slide once per page so the sidebar can show numbered thumbnails.
const slides = await Promise.all(
  slideEntries.map(async (entry, idx) => {
    const { Content } = await render(entry);
    return { Content, title: entry.data.title, pageNo: idx + 1 };
  }),
);

const current = slides[pageNo - 1];
const { Content } = current;
const title = current.title;
const steps = slideEntries[pageNo - 1].data.steps;
---

<Presentation
  slug={slug}
  pageNo={pageNo}
  total={total}
  steps={steps}
  presTitle={presTitle}
  title={title}
  slides={slides}
>
  <Content />
</Presentation>