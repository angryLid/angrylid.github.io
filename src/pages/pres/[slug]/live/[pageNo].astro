---
import { type CollectionEntry, render } from "astro:content";
import Presentation from "@layouts/Presentation.astro";
import { getPresDecks } from "@utils/pres";

export async function getStaticPaths() {
  const decks = await getPresDecks();

  const paths: {
    params: { slug: string; pageNo: string };
    props: {
      slug: string;
      pageNo: number;
      total: number;
      presTitle: string;
      slideEntries: CollectionEntry<"pres">[];
    };
  }[] = [];

  for (const { slug, slides, total, presTitle } of decks) {
    slides.forEach((_entry, idx) => {
      paths.push({
        params: { slug, pageNo: String(idx + 1) },
        props: {
          slug,
          pageNo: idx + 1,
          total,
          presTitle,
          slideEntries: slides,
        },
      });
    });
  }
  return paths;
}

interface Props {
  slug: string;
  pageNo: number;
  total: number;
  presTitle: string;
  slideEntries: CollectionEntry<"pres">[];
}

const { slug, pageNo, total, presTitle, slideEntries } = Astro.props;

// Render every slide once per page so the sidebar can show numbered thumbnails.
const slides = await Promise.all(
  slideEntries.map(async (entry, idx) => {
    const { Content } = await render(entry);
    return { Content, title: entry.data.title, pageNo: idx + 1 };
  }),
);

const current = slides[pageNo - 1];
const { Content } = current;
const title = current.title;
const steps = slideEntries[pageNo - 1].data.steps;
---

<Presentation
  slug={slug}
  pageNo={pageNo}
  total={total}
  steps={steps}
  presTitle={presTitle}
  title={title}
  slides={slides}
>
  <Content />
</Presentation>