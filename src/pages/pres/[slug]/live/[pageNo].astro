---
// ============================================================================
// /pres/[slug]/live/[pageNo]/ — one static HTML page per slide
// ============================================================================
// Renders ONLY the current slide. The slide's component is resolved from the
// module glob by id at render time, so each page bundles just its own slide
// (the ±1 neighbors are prefetched so a page-turn navigate() hits the HTTP
// cache instead of being a cold roundtrip; see Presentation.astro).
// ============================================================================
import Presentation from "@pres/layouts/Presentation.astro";
import { getPresDecks, getSlideModule } from "@pres/lib/pres";

export async function getStaticPaths() {
  const decks = await getPresDecks();

  return decks.flatMap(({ slug, slides, total, deckTitle }) =>
    slides.map((slide, idx) => ({
      params: { slug, pageNo: String(idx + 1) },
      props: {
        slug,
        pageNo: idx + 1,
        total,
        deckTitle,
        crumbs: slide.crumbs,
        slideId: slide.id,
        title: slide.title,
        steps: slide.steps,
        // Lightweight menu metadata (titles + crumb chain, no markup).
        slides: slides.map((s, i) => ({
          pageNo: i + 1,
          title: s.title,
          crumbs: s.crumbs,
        })),
      },
    })),
  );
}

interface Props {
  slug: string;
  pageNo: number;
  total: number;
  deckTitle: string;
  crumbs: string[];
  slideId: string;
  title: string;
  steps: number;
  slides: { pageNo: number; title: string; crumbs: string[] }[];
}

const { slug, pageNo, total, deckTitle, crumbs, slideId, title, steps, slides } =
  Astro.props;
const { default: Slide } = await getSlideModule(slideId);
---

<Presentation
  slug={slug}
  pageNo={pageNo}
  total={total}
  steps={steps}
  deckTitle={deckTitle}
  crumbs={crumbs}
  title={title}
  slides={slides}
>
  <Slide />
</Presentation>
