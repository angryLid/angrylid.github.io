---
import { type CollectionEntry, render } from "astro:content";
import PresHead from "@components/PresHead.astro";
import SlideFrame from "@components/SlideFrame.astro";
import { getPresDecks } from "@utils/pres";

export async function getStaticPaths() {
  const decks = await getPresDecks();
  return decks.map(({ slug, slides, total, presTitle }) => ({
    params: { slug },
    props: { slides, total, presTitle },
  }));
}

interface Props {
  slides: CollectionEntry<"pres">[];
  total: number;
  presTitle: string;
}

const { slug } = Astro.params;
const { slides, total, presTitle } = Astro.props;
const rendered = await Promise.all(
  slides.map(async (entry) => {
    const { Content } = await render(entry);
    return { Content, steps: entry.data.steps, title: entry.data.title };
  }),
);
---

<!doctype html>
<html lang="en">
  <PresHead title={`${presTitle} — Presenter`} />

  <style is:global>
    html,
    body {
      height: 100%;
    }

    /* preview scaling — faithful miniature of the 1280x720 design.
       Base .preview-stage/.preview-inner markup, CSS and scaling come from the
       shared <SlideFrame> component; only the mode-specific radius and the
       current/next highlight frames are defined here. */
    .preview-stage {
      border-radius: calc(var(--border-radius) - 2px);
    }
    /* current page: red highlight frame */
    .current .preview-stage {
      border: 0.5px solid #e23b3b;
      box-shadow: 0 0 0 1px #e23b3b, 0 0 8px rgba(226, 59, 59, 0.28);
    }
    /* next page: gray dashed translucent frame */
    .next-thumb .preview-stage {
      border: 0.5px dashed rgba(120, 120, 120, 0.5);
    }

    .slide-section[hidden] {
        display: none;
      }

      /* presenter layout */
      .presenter {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto 1fr 1fr;
        gap: 1rem;
        padding: 1rem;
        height: 100vh;
      }
      .topbar {
        grid-column: 1 / 3;
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .topbar h1 {
        font-size: 1.1rem;
        color: var(--dark-mint);
        margin-right: auto;
      }
      .current {
        grid-column: 1;
        grid-row: 2;
        min-height: 0;
      }
      .next-thumb {
        grid-column: 1;
        grid-row: 3;
        min-height: 0;
      }
      .notes {
        grid-column: 2;
        grid-row: 2 / 4;
        overflow: auto;
        background: var(--white);
        border-radius: var(--border-radius);
        padding: 1.5rem;
        font-size: 1.15rem;
        line-height: 1.7;
      }
      .notes:empty::before {
        content: "(no notes for this slide)";
        color: var(--gray);
        font-style: italic;
      }
      .notes :is(h1, h2, h3) {
        color: var(--dark-mint);
        margin: 0.4em 0;
      }
      .notes ul,
      .notes ol {
        margin: 0.4em 0 0.4em 1.5em;
      }
      .slide-section {
        height: 100%;
      }
      button {
        font: inherit;
        padding: 0.4rem 1rem;
        border-radius: var(--border-radius);
        border: 1px solid var(--dark-mint);
        background: var(--white);
        color: var(--dark-mint);
        cursor: pointer;
      }
      button:hover {
        background: var(--mint-green);
      }
      #counter {
        font-family: "Cascadia Code", monospace;
        opacity: 0.7;
      }
      .page-titles {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-left: 1rem;
        margin-right: auto;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
      }
      .page-title {
        font-size: 0.95rem;
        line-height: 1.3;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
      .page-title .label {
        opacity: 0.6;
      }
      .page-title.current-page-title {
        color: #e23b3b;
        font-weight: 600;
      }
      .page-title.next-page-title {
        color: rgba(120, 120, 120, 0.8);
      }
      .page-title.next-page-title[hidden] {
        display: none;
      }
    </style>

  <body data-slug={slug} data-total={String(total)}>
    <div class="presenter">
      <div class="topbar">
        <h1>{presTitle}</h1>
        <div class="page-titles">
          <span class="page-title current-page-title"
            ><span class="label">当前页:</span><b id="current-title"></b
          ></span>
          <span class="page-title next-page-title"
            ><span class="label">下一页:</span><b id="next-title"></b
          ></span>
        </div>
        <button id="prev" type="button">Prev</button>
        <button id="next" type="button">Next</button>
        <span id="counter">1 / {total}</span>
      </div>
      <div class="current">
        {
          rendered.map(({ Content, steps, title }, idx) => (
            <section
              class="slide-section"
              data-page={idx + 1}
              data-steps={steps}
              data-title={title}
              hidden={idx !== 0}
            >
              <SlideFrame fit="contain">
                <Content />
              </SlideFrame>
            </section>
          ))
        }
      </div>
      <div class="notes" id="notes"></div>
      <div class="next-thumb">
        <div class="preview-stage" data-fit="contain">
          <div class="preview-inner" id="next-inner"></div>
        </div>
      </div>
    </div>

    <script>
      import {
        computeSteps as computeSharedSteps,
        syncVisibility,
      } from "../../../utils/pres-visibility";
      import { extractNotes } from "../../../utils/pres-notes";

      const channel = new BroadcastChannel("pres-speaker");
      const slug = document.body.dataset.slug ?? "";
      const total = parseInt(document.body.dataset.total ?? "0", 10);
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>(".slide-section"),
      );
      const notesPanel = document.getElementById("notes")!;
      const counter = document.getElementById("counter")!;
      const nextInner = document.getElementById("next-inner")!;
      const currentTitle = document.getElementById("current-title")!;
      const nextTitle = document.getElementById("next-title")!;
      const nextTitleEntry = nextTitle.closest(".page-title") as HTMLElement;

      let currentPage = 1;
      let currentStep = 0;

      function computeSteps(section: HTMLElement): number {
        const frontmatterSteps = parseInt(section.dataset.steps ?? "", 10);
        return computeSharedSteps(section, frontmatterSteps);
      }

      function setStep(step: number): void {
        currentStep = step;
        const section = sections[currentPage - 1];
        if (!section) return;
        syncVisibility(section, step);
      }

      function updateNextThumb(): void {
        nextInner.replaceChildren();
        const nextSection = sections[currentPage]; // 0-indexed: next slide
        if (!nextSection) {
          nextTitle.textContent = "";
          nextTitleEntry.hidden = true;
          return;
        }
        nextTitle.textContent = nextSection.dataset.title ?? "";
        nextTitleEntry.hidden = !nextTitle.textContent;
        const slide = nextSection.querySelector(".slide");
        if (!slide) return;
        const clone = slide.cloneNode(true) as HTMLElement;
        // show all anim elements in the thumbnail
        clone.querySelectorAll("[data-anim]").forEach((el) => {
          el.setAttribute("data-visible", "");
        });
        nextInner.append(clone);
      }

      function showPage(page: number, step?: number): void {
        const target = Math.max(1, Math.min(total, page));
        const section = sections[target - 1];
        if (!section) return;
        sections.forEach((s) => {
          s.hidden = true;
        });
        currentPage = target;
        currentTitle.textContent = section.dataset.title ?? "";
        setStep(step ?? 0); // set visibility WHILE hidden (no flash)
        section.hidden = false; // reveal with correct state
        const notes = extractNotes(section);
        notesPanel.replaceChildren(
          notes ?? document.createTextNode(""),
        );
        counter.textContent = `${target} / ${total}`;
        updateNextThumb();
      }

      function broadcast(): void {
        channel.postMessage({
          kind: "state",
          slug,
          pageNo: currentPage,
          step: currentStep,
          total,
        });
      }

      function goNext(): void {
        const steps = computeSteps(sections[currentPage - 1]);
        if (currentStep < steps - 1) {
          setStep(currentStep + 1);
          broadcast();
        } else if (currentPage < total) {
          showPage(currentPage + 1, 0);
          broadcast();
        }
      }

      function goPrev(): void {
        if (currentStep > 0) {
          setStep(currentStep - 1);
          broadcast();
        } else if (currentPage > 1) {
          const prevSteps = computeSteps(sections[currentPage - 2]);
          showPage(currentPage - 1, prevSteps - 1);
          broadcast();
        }
      }

      channel.onmessage = (e: MessageEvent) => {
        const msg = e.data;
        if (!msg || msg.slug !== slug) return;
        if (msg.kind === "request-state") {
          broadcast();
          return;
        }
        if (msg.kind !== "state") return;
        if (msg.pageNo !== currentPage) {
          showPage(msg.pageNo, msg.step);
        } else {
          setStep(msg.step);
        }
      };

      // Init — no ClientRouter, no astro:page-load. Deferred module runs after
      // DOM is ready. Read ?page= for initial slide, then ask main for state.
      const initialPage = parseInt(
        new URLSearchParams(location.search).get("page") ?? "1",
        10,
      );
      showPage(initialPage, 0);
      channel.postMessage({ kind: "request-state", slug });

      document.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "ArrowRight" || e.key === "ArrowDown") {
          e.preventDefault();
          goNext();
        } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
          e.preventDefault();
          goPrev();
        }
      });
      document.getElementById("prev")?.addEventListener("click", goPrev);
      document.getElementById("next")?.addEventListener("click", goNext);
    </script>
  </body>
</html>
