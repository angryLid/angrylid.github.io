---
import PresentationLayout from "@pres/components/PresentationLayout.astro";
import PhotoCollage from "@pres/components/PhotoCollage.astro";
import pudacuo from "./assets/Shangri-La/pudacuo.jpg";
import dukezong from "./assets/Shangri-La/dukezong.jpg";
import sumtseling from "./assets/Shangri-La/sumtseling.jpg";
import tigerLeapingGorge from "./assets/Shangri-La/tiger-leaping-gorge.jpg";
import Notes from "@pres/components/Notes.astro";

export const meta = {"title":"Warmup - Shangri-La","steps":3};
---

<PresentationLayout title="香格里拉 Shangri-La" reverse>
  <div class:list={["photo", "photo1"]}>
    <PhotoCollage src={pudacuo.src} alt="普达措国家公园" caption="普达措国家公园" />
  </div>
  <div data-anim="1" class:list={["photo", "photo2"]}>
    <PhotoCollage src={dukezong.src} alt="独克宗古城" caption="独克宗古城" />
  </div>
  <div data-anim="2" class:list={["photo", "photo3"]}>
    <PhotoCollage src={sumtseling.src} alt="噶丹松赞林寺" caption="噶丹松赞林寺" />
  </div>
  <div data-anim="3" class:list={["photo", "photo4"]}>
    <PhotoCollage src={tigerLeapingGorge.src} alt="虎跳峡" caption="虎跳峡" />
  </div>
</PresentationLayout>

<Notes>

没错，它就是——香格里拉。

这个名字出自一位英国作家（詹姆斯·希尔顿 ）1933 年的小说《消失的地平线》，书中描绘了一个虚构的（喜马拉雅）乌托邦山谷，香格里拉。

香格里拉这个名字比这本书的名气还要大，成为了乌托邦的一种代词。中国有至少三个地方，曾经都争夺过这个地名。国务院一直没有批准，或许是因为中国搞一个英语的地名，这似乎不合乎周礼。

2001 年，原来的云南中甸县正式更名为"香格里拉"。它也是中国唯一一个名称源自英语文学造词的城市。

当然这也没有什么稀奇的，自从 1997 年香港回归以后，英语顺理成章的也变成少数民族语言了。

这是香格里拉的一些景区。普达措国家公园，独克宗古城，噶丹松赞林寺，虎跳峡。

</Notes>
