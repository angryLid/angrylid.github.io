---
import PresentationLayout from "@pres/components/PresentationLayout.astro";
import PresentationStep from "@pres/components/PresentationStep.astro";
import TypewriterList from "@pres/components/TypewriterList.astro";
---

<PresentationLayout title="免责声明">
  <div class="wrap">
    <PresentationStep step={0}>
      <TypewriterList
        items={['谨在此提请任何可能直接或间接、以现在时或将来时、在此地或任何其他管辖范围内接触到本次演示，并可能据此作为或不作为的听众注意：鉴于接下来所陈述之一切均属本人于特定时点基于自身认知所倾向于相信之内容，故其<strong>不构成、不应被视为构成、亦不得被推定为意图构成</strong>任何明示或默示、法律或事实意义上的<strong>投资建议</strong>；鉴于演示中提及之一切资产、产品与案例仅为说明之便而存在，故其不代表、不应被解读为代表、亦不得被推定为意图代表任何形式的<strong>推荐、暗示或劝诱</strong>；鉴于财富之管理从根本上系一项个人性、不可让渡、不可转委托之责任，故每一位听众都应——且仅应——被视为其自身财富之<strong>第一责任人</strong>，而本人在任何情形下均无意、亦不试图承担此项光荣而沉重的义务。']}
        speed={140}
        itemGap="0"
        fontSize="2rem"
        lineHeight={1.9}
      />
    </PresentationStep>
  </div>
</PresentationLayout>

<style>
  /* ---- page-specific: 02b-disclaimer ---- */
  .wrap {
    padding: 0.5rem 3rem 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
