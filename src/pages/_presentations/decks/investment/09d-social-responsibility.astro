---
import PresentationLayout from "@pres/components/PresentationLayout.astro";
import shareholdersCarryingLock from "./assets/svg/shareholders-carrying-lock.svg";
import shareholdersBurningMoney from "./assets/svg/shareholders-burning-money.svg";
import Notes from "@pres/components/Notes.astro";

export const meta = {"title":"盘外招二 · 民生工程与社会责任","steps":1};
---

<PresentationLayout
  title="民生工程与社会责任"
  narrow
>
  <div class="root">
    <div class="mainGrid">
      <img src={shareholdersBurningMoney.src} alt="多名头戴“股民”头巾的人往燃烧的锅炉里塞钞票" class="svg imgBoiler" />
      <div class="caption capBoiler">
        <p class="captionTitle">火电厂 · 亏本保供（2021）</p>
        <p class="captionLine">煤价疯涨，一度电倒贴 2-3 毛</p>
        <p class="captionSub">保供死命令下不许停机，合计亏损超 460 亿</p>
      </div>
      <div class="caption capLock">
        <p class="captionTitle">长江电力 · 葛洲坝扩建（2025）</p>
        <p class="captionLine">266亿“公益项目”</p>
        <p class="captionSub">96.02% 赞成率强行通过</p>
      </div>
      <img src={shareholdersCarryingLock.src} alt="多名头戴“股民”头巾的人肩扛着一座船闸" class="svg imgLock" />
    </div>
  </div>
</PresentationLayout>

<Notes>

【长江电力 · 266 亿葛洲坝航运扩能（2025）】
2025 年 7 月 30 日晚，长江电力公告拟以自有资金出资约 266 亿建设葛洲坝航运扩能：拆除三号船闸、新建两线万吨级船闸，总工期长达 91 个月。葛洲坝过闸完全免费，设计年单向通过能力仅 5000 万吨，2024 年实际过闸货量已达 1.56 亿吨——纯公益基建，回本遥遥无期。8 月 15 日武汉临时股东会，董事长再度缺席遭现场炮轰，5.72 亿股反对、1.55 亿股弃权，公告次日股价跌 3%；国资绝对控股下，议案仍以 96.02% 赞成率强行通过。

【火电厂 · 亏本保供（2021）】
市场煤，计划电：2021 年动力煤从年初约 600 元/吨一路飙至 10 月历史峰值 2600 元/吨，电价却仍被管死，火电厂每发一度电倒贴 2-3 毛，“发电越多、亏得越多”。保供死命令下不许停机：仅华能国际一家就采购 2.03 亿吨煤、燃料成本 1465 亿（+65%），巨亏 102.64 亿并首次不分红；A 股 18 家火电公司合计亏损超 460 亿，全国煤电因煤价额外多掏约 6000 亿。次年发改委被迫改规：电价上浮放宽至 20%、高耗能上不封顶，电煤长协 100% 锁价。

</Notes>
<style>
  .root {
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .mainGrid {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 0.9rem 1.6rem;
  }

  /* boiler image: column 1, rows 1-2 */
  .imgBoiler {
    grid-area: 2 / 1 / 4 / 2;
    align-self: center;
  }

  /* boiler caption: column 2, row 1 */
  .capBoiler {
    grid-area: 1 / 1 / 2 / 2;
    align-self: center;
  }

  /* lock image: column 2, rows 2-3 */
  .imgLock {
    grid-area: 1 / 2 / 3 / 3;
    align-self: end;
  }

  /* lock caption: column 1, row 3 */
  .capLock {
    grid-area: 3 / 2 / 4 / 3;
    align-self: end;
  }

  .svg {
    display: block;
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .caption {
    flex: none;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-border);
    background: #f8fafc;
  }

  /* hydropower story: blue tones */
  .capLock {
    background: #eff6ff;
    --color-border: #1f4e79; 
  }

  .capLock .captionTitle,
  .capLock .captionLine,
  .capLock .captionSub {
    color: #1f4e79;
  }

  /* thermal power story: black + red tones */
  .capBoiler {
    background: #fdf0ee;
    --color-border: #c0392b;
  }

  .capBoiler .captionTitle,
  .capBoiler .captionLine,
  .capBoiler .captionSub {
    color: #1a1a1a;
  }

  /* all three lines share the middle line's size and color; only weight differs */
  .captionTitle {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .captionLine {
    margin: 0.2rem 0 0;
    font-size: 1.05rem;
    font-weight: 400;
  }

  .captionSub {
    margin: 0.2rem 0 0;
    font-size: 1.05rem;
    font-weight: 400;
  }
</style>
