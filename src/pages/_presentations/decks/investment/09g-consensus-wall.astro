---
import PresentationLayout from "@pres/components/PresentationLayout.astro";
import PhotoCollage from "@pres/components/PhotoCollage.astro";

import jade from "./assets/consensus-wall/01-jade.jpg";
import calligraphy from "./assets/consensus-wall/02-calligraphy.jpg";
import teaLiquor from "./assets/consensus-wall/03-tea-liquor.jpg";
import stamps from "./assets/consensus-wall/04-stamps.jpg";
import sneakers from "./assets/consensus-wall/07-sneakers.jpg";
import cards from "./assets/consensus-wall/09-cards.jpg";
import blindBox from "./assets/consensus-wall/10-blindbox.jpg";
import lego from "./assets/consensus-wall/12-lego.jpg";
import Notes from "@pres/components/Notes.astro";

// Two rows of four overlapping cards. Each row gets only a slight fan: the
// cards rotate a few degrees outward and ride a shallow arc, so the row reads
// as a casually spread hand rather than a rigid grid. Both effects are driven
// by two numbers (ROT_MAX / DROOP) plus STRIDE for the overlap.
const CARD_W = 250;
const CARD_H = 54 + ((CARD_W - 26) * 3) / 4;
const STRIDE = 240;
const ROT_MAX = 4.5;
const DROOP = 10;
const CENTER_X = 640;

function cardPos(i: number, n: number) {
  const t = (i - (n - 1) / 2) / ((n - 1) / 2);
  return {
    x: CENTER_X + (i - (n - 1) / 2) * STRIDE,
    y: CARD_H / 2 + t * t * DROOP,
    deg: t * ROT_MAX,
  };
}

const rows = [
  {
    cards: [
      { src: jade.src, alt: "白玉雕件", name: "玉石" },
      { src: calligraphy.src, alt: "中国画长卷", name: "文玩字画" },
      { src: teaLiquor.src, alt: "名酒礼盒", name: "名茶名酒" },
      { src: stamps.src, alt: "整版老邮票", name: "邮票" },
    ],
  },
  {
    cards: [
      { src: sneakers.src, alt: "限量球鞋", name: "限量球鞋" },
      { src: cards.src, alt: "集换式卡牌", name: "游戏卡牌" },
      { src: blindBox.src, alt: "潮玩盲盒门店", name: "潮玩盲盒" },
      { src: lego.src, alt: "绝版乐高套装", name: "绝版乐高" },
    ],
  },
];


export const meta = {"title":"共识类资产图鉴"};
---

<PresentationLayout title="共识类资产图鉴" reverse>
  <div class="root">
    {
      rows.map((row) => (
        <div class="fan" style={`--h:${CARD_H + DROOP}px;--w:${CARD_W}px`}>
          {row.cards.map((card, cardIndex) => {
            const s = cardPos(cardIndex, row.cards.length);
            return (
              <div
                class="card"
                style={`--x:${s.x}px;--y:${s.y}px;--rot:${s.deg}deg;z-index:${cardIndex + 1}`}
              >
                <PhotoCollage src={card.src} alt={card.alt} caption={card.name} />
              </div>
            );
          })}
        </div>
      ))
    }
  </div>
</PresentationLayout>

<Notes>

在看定义之前，先来认认这些实物。它们本身不产生任何现金流，价值完全来自市场共识。

上排是所谓的"长者资产"，也就是上一辈人炒起来的东西：玉石、文玩字画、名茶名酒、邮票。邮票要多说一句：九十年代集邮热崩盘之后，它就是「共识崩塌」的活教材。

下排是年轻一代的版本，也就是"小登资产"：限量球鞋、游戏卡牌、潮玩盲盒、绝版乐高。炒鞋崩盘、宝可梦卡疯涨、泡泡玛特上市，年轻人玩的是同一套共识，只是换了个马甲。

两排的东西看起来风马牛不相及，但底层逻辑是同一套。下一页我们来拆解它们共同的三大特性。

</Notes>
<style>
  .root {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.1rem;
  }

  .fan {
    position: relative;
    height: var(--h);
  }

  .card {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--w);
    transform: translate(var(--x), var(--y)) translate(-50%, -50%)
      rotate(var(--rot));
  }
</style>
