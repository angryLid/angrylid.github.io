---
import PresentationLayout from "@pres/components/PresentationLayout.astro";
import Notes from "@pres/components/Notes.astro";

interface LadderRow {
  rank: number;
  name: string;
  desc: string;
  dots: number;
  color: string;
  hot?: boolean;
}

const rows: LadderRow[] = [
  { rank: 1, name: "常规活动", desc: "人不吃饭就会饿死，从楼上跳下来就会摔死 — 自然规律支配，结果近乎确定", dots: 5, color: "#2e7d32" },
  { rank: 2, name: "打工", desc: "行业兴衰难以预料，但「付出劳动换取收入」大体可期", dots: 4, color: "#7cb342" },
  { rank: 3, name: "经商", desc: "需求、对手、成本皆由他人决定，预测难度陡增", dots: 3, color: "#f9a825" },
  { rank: 4, name: "投资", desc: "在别人经营的不确定性上，再叠加估值与人心的不确定性", dots: 2, color: "#ef6c00", hot: true },
  { rank: 5, name: "赌博", desc: "无内幕消息则完全不可预测，长期数学期望为负", dots: 1, color: "#c0392b" },
];

export const meta = {"title":"预测未来有多难","steps":1};
---

<PresentationLayout title="预测未来有多难" narrow>
  <div class="ladder">
    <div class="legend">
      <span class="legendDot" />
      <span>实心圆越多 = 越可预测</span>
    </div>

    {
      rows.map((r) => (
        <div class:list={["row", { hot: r.hot }]}>
          <div class="rank" style={`background: ${r.color}`}>
            {r.rank}
          </div>
          <div class="text">
            <div class="name" style={r.hot ? "color: #c0392b" : undefined}>
              {r.name}
              {r.hot && <span class="hotBadge">本讲主题</span>}
            </div>
            <div class="desc">{r.desc}</div>
          </div>
          <div class="meter">
            {[1, 2, 3, 4, 5].map((i) => (
              <span
                class="dot"
                style={i <= r.dots ? `background: ${r.color}` : undefined}
              />
            ))}
          </div>
        </div>
      ))
    }

    <div class="takeaway">
      预测难度每下一层，确定性就少一分 — 所以投资的第一课不是学会预测，而是先弄清楚<span
        class="takeawayEm">什么才算好资产</span
      >。
    </div>
  </div>
</PresentationLayout>

<Notes>

这一页把人类活动按「预测未来的难度」排成一个阶梯，从上往下走一遍：

- 常规活动：自然科学规律说了算。人不吃饭就会饿死，从楼上跳下来就会摔死——这些事不需要预测，只需要知道规律。所以凡是纯由自然规律支配的活动，结果近乎确定，这是确定性最强的一层。
- 打工：你预测不了所在行业十年后还在不在（比如收费站、翻译），但「付出劳动、换取收入」这个机制本身相当稳定，所以大致可预期。
- 经商：客户、对手、成本，全都是会变的人和行为。生意难做，但利润正是对承担这份不确定性的回报。
- 投资：比经商更难——你不只要判断一门生意好不好，还要判断别人愿意为这门生意出什么价。巴菲特说苹果是好资产，段永平说茅台是好资产，今天看都对；但茅台的董事长一边拍胸脯说年轻人到了年纪自然会喝白酒，一边又跑去跟 9.9 的瑞幸联名——连管理层自己都没有十足的把握。
- 赌博：阶梯的最底端。没有内幕消息时完全不可预测，数学期望还是负数。

收束：很多散户做投资，其实是在信息极不充分的情况下预测未来——人站在阶梯底端，却以为自己在第二层。所以下一页我们退一步：先不谈预测，先谈什么才算好资产。

</Notes>
<style>
  .ladder {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .legend {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
    color: #999;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }

  .legendDot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: #2e7d32;
  }

  .row {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    background: #fff;
  }

  .row.hot {
    border: 2px solid #c0392b;
    background: rgba(192, 57, 43, 0.06);
  }

  .rank {
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .name {
    font-size: 1.3rem;
    font-weight: 700;
    color: #111;
    line-height: 1.3;
  }

  .hotBadge {
    margin-left: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    background: #c0392b;
    border-radius: 999px;
    padding: 0.08rem 0.6rem;
    vertical-align: 0.12em;
  }

  .desc {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.5;
  }

  .meter {
    flex: none;
    display: flex;
    gap: 0.3rem;
  }

  .dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: #e5e5e5;
    display: inline-block;
  }

  .takeaway {
    border-left: 4px solid #c0392b;
    padding: 0.5rem 1rem;
    font-size: 1.05rem;
    color: #333;
    line-height: 1.55;
  }

  .takeawayEm {
    font-weight: 700;
    color: #c0392b;
  }
</style>
