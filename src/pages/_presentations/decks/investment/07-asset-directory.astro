---
import PresentationLayout from "@pres/components/PresentationLayout.astro";
import Notes from "@pres/components/Notes.astro";

const categories = [
  {
    className: "green",
    emoji: "💰",
    title: "生息资产",
    subtitle: "能持续产生现金流",
    items: [
      {
        emoji: "📜",
        title: "债券",
        description: "固定收益，到期还本",
        predict: "债务人到期能否履约",
      },
      {
        emoji: "📈",
        title: "股票（红利股）",
        description: "分红派息，分享成长",
        predict: "企业能否持续盈利、照常分红",
      },
    ],
  },
  {
    className: "amber",
    emoji: "🪙",
    title: "共识类资产",
    subtitle: "价值来自集体认同",
    items: [
      {
        emoji: "👴",
        title: "长者资产",
        description: "代代相传的价值储存",
        predict: "投机狂热正处于早期还是已入末期",
      },
      {
        emoji: "🔶",
        title: "黄金",
        description: "千年硬通货",
        predict: "避险情绪何时逆转，央行会否集中购金",
      },
    ],
  },
  {
    className: "blue",
    emoji: "📈",
    title: "成长类",
    subtitle: "价值来自未来增长",
    items: [
      {
        emoji: "🚀",
        title: "成长股",
        description: "押注未来高增长",
        predict: "高增长能否如期兑现",
      },
      {
        emoji: "🏠",
        title: "不动产",
        description: "区位 & 流动性溢价",
        predict: "区位价值与人口流向能否长期向上",
      },
    ],
  },
];

export const meta = {"title":"资产的分类","steps":1};
---

<PresentationLayout title="资产的分类" narrow>
  <div class="root">
    {
      categories.map((category) => (
        <Fragment>
          <div class:list={["cell", "catHeader", category.className]}>
            <div class="headText">
              <p class="catTitle">{category.emoji} {category.title}</p>
              <p class="catSubtitle">{category.subtitle}</p>
            </div>
          </div>
          {category.items.map((item) => (
            <div class:list={["cell", "item", category.className]}>
              <div class="itemText">
                <p class="itemTitle">{item.emoji} {item.title}</p>
                <p class="itemDesc">{item.description}</p>
                <p class="itemPredict">
                  <span class="predictLead">需要预测</span>{item.predict}
                </p>
              </div>
            </div>
          ))}
        </Fragment>
      ))
    }
  </div>
</PresentationLayout>

<Notes>

所以断定什么是好资产之前，还是有必要说明白资产的一些基本性质。

那么尽量要避免自己就变成一个金融消费者了。

所以我们现在来讨论一个基本的原理，就是说你买一个东西，比如说过了半年，那个人凭什么就要花更高的价格买呢。

答案藏在每个品类要求你预测的那个「未来」里。这一页把资产分成三大类、六个品种，每个品种下面都标了它要求你预测的未来：

1. 生息资产赌的是「一纸承诺的兑现」：债券赌债务人到期还能还本付息，红利股赌企业持续盈利、照常分红。
2. 共识类资产赌的其实不是「共识会不会破」——能流传下来的共识基本是永续的，黄金千年不破。你真正要预测的是周期和情绪：长者资产，赌的是郁金香式炒作走到了早期还是晚期；黄金，赌的是短期情绪的乐观与恐慌，以及各国央行买卖造成的短期供需。共识类还有一个特点，就是供给量的增长跟不上需求量的增长。
3. 成长类（成长股和不动产）赌的是「增长的兑现」：营收利润如期高增长，区位价值与人口流向长期向上。

（至于衍生品，它依附于资产而存在，这一页先不展开，放到后面讲期货的时候再说。）

所以买任何资产之前，先问自己：它要求我预测的那个未来，我有几分把握？这正是上一页那架预测难度阶梯的延续——不同资产，站在阶梯的不同高度上。

</Notes>
<style>
  .root {
    --surface: #fff;
    --text: #333;
    --muted-text: #888;
    --shadow: rgba(0, 0, 0, 0.05);
    --green: #166534;
    --green-sub: #15803d;
    --green-border: #27ae60;
    --amber: #9a3412;
    --amber-sub: #b45309;
    --amber-border: #ea580c;
    --blue: #1e40af;
    --blue-sub: #2563eb;
    --blue-border: #2563eb;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 2fr 2fr;
    grid-template-rows: repeat(3, 1fr);
    column-gap: 0;
    row-gap: 1.2rem;
  }

  .green { --accent: var(--green); --sub-accent: var(--green-sub); --border-accent: var(--green-border); }
  .amber { --accent: var(--amber); --sub-accent: var(--amber-sub); --border-accent: var(--amber-border); }
  .blue { --accent: var(--blue); --sub-accent: var(--blue-sub); --border-accent: var(--blue-border); }

  .cell {
    background: var(--surface);
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.9rem 1.2rem;
    box-shadow: 0 1px 3px var(--shadow);
    min-width: 0;
  }

  .catHeader {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .item {
    background: var(--surface);
  }

  .catTitle {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0;
    line-height: 1.25;
  }

  .catSubtitle {
    font-size: 1.05rem;
    color: var(--sub-accent);
    margin: 0.15rem 0 0;
  }

  .itemText {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    min-width: 0;
  }

  .itemTitle {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: 1.25;
  }

  .itemDesc {
    font-size: 1.1rem;
    color: var(--muted-text);
    margin: 0;
  }

  .itemPredict {
    font-size: 1.05rem;
    color: var(--muted-text);
    margin: 0.25rem 0 0;
    line-height: 1.45;
  }

  .predictLead {
    font-weight: 700;
    color: var(--sub-accent);
    margin-right: 0.4rem;
  }
</style>
