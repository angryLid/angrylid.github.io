---
import PresentationLayout from "@pres/components/PresentationLayout.astro";
import Notes from "@pres/components/Notes.astro";

// 数据与样式分离：每张卡片只声明内容，结构由下方统一渲染
const cards = [
  {
    anim: 0,
    cls: "premiseRow",
    bottomTitle: "张三借给李四 100 元,约定一年后归还",
    bottomClass: "premiseText",
    zhangEmoji: "😟",
    liEmoji: "😊",
    amount: "¥100",
    arrow: "→",
  },
  {
    anim: 1,
    cls: "resultCard resultDefault",
    bottomTitle: "坏结果 · 赖账",
    bottomClass: "resultTitleRed",
    zhangEmoji: "🤡",
    liEmoji: "🤣",
    amount: "¥0",
    arrow: "←",
  },
  {
    anim: 2,
    cls: "resultCard resultRepay",
    bottomTitle: "好结果 · 逾期还清本金",
    bottomClass: "resultTitleGreen",
    zhangEmoji: "😮‍💨",
    liEmoji: "🙂",
    amount: "¥100",
    arrow: "←",
  },
];

export const meta = {"title":"债券是什么 · 一张欠条","steps":3};
---

<PresentationLayout title="民间借贷的缺陷" narrow>
  <div class="root">
    {cards.map((c) => (
      <div data-anim={c.anim} class:list={["card", c.cls]}>
        <div class="transfer">
          <div class="person">
            <div class="personEmoji">{c.zhangEmoji}</div>
            <div class="personName">张三</div>
          </div>
          <div class="transferAmount">
            <div class="amountNum">{c.amount}</div>
            <div class:list={["amountArrow", { reverse: c.arrow === "←" }]}></div>
          </div>
          <div class="person">
            <div class="personEmoji">{c.liEmoji}</div>
            <div class="personName">李四</div>
          </div>
        </div>
        <div class:list={["cardTitle", c.bottomClass]}>{c.bottomTitle}</div>
      </div>
    ))}
  </div>
</PresentationLayout>

<Notes>
在讲债券之前，我稍微提一下借据，也就是欠条。

比如说，张三借给李四 100 元钱，约定 1 年后还钱。那么到了 1 年以后，**李四就以赖账的手段赚取了 100 元。那么这就是民间借贷赚钱的原理。**

当然，还有一种好的情况，就是李四在几年之后终于把本金 100 元还上了。

所以 其一，欠条是一种回购承诺，是对方答应你未来他出更高的价格把欠条买回去。
其二，他到底会不会履行这个承诺呢。说不清楚。如果他毁约，你这张欠条怎么办呢。

这就是民间借贷的缺陷：**无法保证债务人履约，更没有标准化的交易市场，**

</Notes>
<style>
  .root {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1rem;
  }

  /* Shared card base: column flex, uniform padding and centered text */
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1rem 1.4rem;
    text-align: center;
  }

  /* Shared bottom-title typography; color comes from the concrete class */
  .cardTitle {
    order: 2;
    font-size: 1.5rem;
    font-weight: 800;
  }

  /* Person diagram */
  .transfer {
    order: 1;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
  }

  .person {
    text-align: center;
  }

  .personEmoji {
    font-size: 4.4rem;
  }

  .personName {
    font-size: 1.3rem;
    font-weight: 700;
    color: #334155;
    margin-top: 0.2rem;
  }

  .transferAmount {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .amountNum {
    font-size: 2.5rem;
    color: var(--amount, #b45309);
    font-weight: 800;
    line-height: 1;
  }

  /* CSS-drawn arrow so the arrow and the amount are visually the same height on every platform */
  .amountArrow {
    position: relative;
    width: 4.5rem;
    height: 0.4rem;
    background: var(--arrow, #f59e0b);
    border-radius: 0.2rem;
  }

  .amountArrow::after {
    content: "";
    position: absolute;
    right: -0.55rem;
    top: 50%;
    transform: translateY(-50%);
    border-left: 0.7rem solid var(--arrow, #f59e0b);
    border-top: 0.5rem solid transparent;
    border-bottom: 0.5rem solid transparent;
  }

  .amountArrow.reverse {
    transform: scaleX(-1);
  }

  /* Premise: spans the whole first column */
  .premiseRow {
    grid-column: 1;
    grid-row: 1 / -1;
    padding: 1rem 1.8rem;
    background: #fffdf4;
    border: 1px solid #e7e0cd;
    box-shadow: 0 2px 6px rgba(30, 41, 59, 0.04);
  }

  /* Result cards share the second column and a 2px border frame */
  .resultCard {
    grid-column: 2;
    border: 2px solid;
  }

  .resultDefault {
    grid-row: 1;
    justify-content: center;
    border-style: dashed;
    border-color: #fca5a5;
    background: #fef2f2;
    --amount: #b91c1c;
    --arrow: #ef4444;
  }

  .resultRepay {
    grid-row: 2;
    border-color: #86efac;
    background: #f0fdf4;
  }

  /* Title colors */
  .premiseText {
    color: #1e293b;
  }

  .resultTitleRed {
    color: #b91c1c;
  }

  .resultTitleGreen {
    color: #16a34a;
  }
</style>
