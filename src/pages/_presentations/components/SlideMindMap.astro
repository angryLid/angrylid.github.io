---
// Mind-map view of the deck for the full-screen sorter menu: the deck node on
// the left, section/slide branches expanding rightward, elbow connectors drawn
// by each branch's pseudo-elements (vertical spine segments + horizontal stub).
// All .mm-* styles are global here (mm- prefix avoids collisions) because the
// nodes are rendered across this component and the recursive MindMapBranch.
import MindMapBranch from "@pres/components/MindMapBranch.astro";
import { buildMenuTree, type MenuSlide } from "@pres/lib/pres-menu";

interface Props {
  deckTitle: string;
  slides: MenuSlide[];
  current: number;
}

const { deckTitle, slides, current } = Astro.props;
const root = buildMenuTree(slides, deckTitle);
---

<div class="mm-root">
  <span class="mm-node mm-deck">{deckTitle}</span>
  {
    root.children.length > 0 && (
      <ul class="mm-children">
        {root.children.map((child) => (
          <MindMapBranch node={child} current={current} />
        ))}
      </ul>
    )
  }
</div>

<style is:global>
  .mm-root {
    display: flex;
    align-items: center;
    padding: 0.5rem;
  }
  /* Each children column is offset from its parent by the spine width; the
     spine/stub pseudo-elements on .mm-branch draw the elbow connectors. */
  .mm-children {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .mm-branch {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.2rem 0;
  }
  /* horizontal stub: spine → node */
  .mm-branch::before {
    content: "";
    position: absolute;
    left: -1.6rem;
    top: 50%;
    width: 1.6rem;
    height: 1px;
    background: rgba(0, 0, 0, 0.22);
  }
  /* vertical spine segment: spans the branch box; first/last children trim it
     to their center so consecutive segments form one continuous line (padding
     instead of gap keeps the boxes contiguous) */
  .mm-branch::after {
    content: "";
    position: absolute;
    left: -1.6rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(0, 0, 0, 0.22);
  }
  .mm-branch:first-child::after {
    top: 50%;
  }
  .mm-branch:last-child::after {
    bottom: 50%;
  }
  .mm-branch:only-child::after {
    display: none;
  }
  .mm-node {
    display: inline-block;
    padding: 0.28rem 0.75rem;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 999px;
    background: var(--white);
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--gray);
    white-space: nowrap;
  }
  .mm-section {
    font-weight: 600;
    color: var(--dark-mint);
    border-color: rgba(34, 139, 34, 0.35);
    background: var(--mint-green);
  }
  .mm-deck {
    background: var(--dark-mint);
    border-color: var(--dark-mint);
    color: var(--white);
    font-weight: 600;
    padding: 0.4rem 0.95rem;
    font-size: 0.9rem;
  }
  .mm-leaf {
    font: inherit;
    cursor: pointer;
    text-align: left;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .mm-leaf:hover {
    border-color: var(--dark-mint);
    color: var(--dark-mint);
  }
  .mm-leaf[data-current] {
    background: var(--dark-mint);
    border-color: var(--dark-mint);
    color: var(--white);
  }
</style>
