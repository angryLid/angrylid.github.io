---
interface Props {
  step: number;
  /** Entrance animation strategy. */
  effect?: "none" | "fade" | "fly" | "blinds";
  /** Direction used by the fly effect. */
  direction?: "up" | "down" | "left" | "right";
  /** Animation duration in seconds. */
  duration?: number;
  /** Delay before the animation starts, in seconds. */
  delay?: number;
  /** Delay between blinds slats, in seconds. */
  stagger?: number;
  /** Number of horizontal blinds slats. */
  strips?: number;
  /** Blinds slat fill colour. */
  slatColor?: string;
}

const {
  step,
  effect = "none",
  direction = "up",
  duration = 0.3,
  delay = 0,
  stagger = 0.06,
  strips = 16,
  slatColor = "var(--light-gray, #fafaf7)",
} = Astro.props as Props;

const slatCount = Math.max(1, Math.floor(strips));
const slats = Array.from({ length: slatCount }, (_, i) => i);
---

<div
  class:list={["presentation-step", `presentation-step-${effect}`, `presentation-step-${effect}-${direction}`]}
  data-anim={step}
  style={`--step-duration:${duration}s;--step-delay:${delay}s;--step-stagger:${stagger}s;--step-slat-color:${slatColor};`}
>
  <slot />
  {effect === "blinds" && (
    <div class="step-blinds-mask" aria-hidden="true">
      {slats.map((i) => <span class="step-blinds-slat" style={`--i:${i};`} />)}
    </div>
  )}
</div>

<style>
  /* Grid/flex items default to min-height:auto / min-width:auto, which can
     force the track to grow past its size when the slotted content has a
     larger min-content height (e.g. a square image inside a fixed grid cell).
     Reset both so the step box sizes to its parent track, not its content. */
  .presentation-step {
    position: relative;
    min-height: 0;
    min-width: 0;
  }

  .presentation-step-fade,
  .presentation-step-fly {
    transition-delay: var(--step-delay);
    transition-duration: var(--step-duration);
  }

  .presentation-step-fly-up {
    transform: translateY(2rem);
  }

  .presentation-step-fly-down {
    transform: translateY(-2rem);
  }

  .presentation-step-fly-left {
    transform: translateX(2rem);
  }

  .presentation-step-fly-right {
    transform: translateX(-2rem);
  }

  .presentation-step-fly[data-visible] {
    transform: translate(0);
  }

  .step-blinds-mask {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .step-blinds-slat {
    flex: 1 1 0;
    background: var(--step-slat-color, var(--light-gray, #fafaf7));
    transform-origin: center;
  }

  .presentation-step-blinds[data-visible] .step-blinds-slat {
    animation: step-blinds-open var(--step-duration) ease forwards;
    animation-delay: calc(
      var(--i, 0) * var(--step-stagger) + var(--step-delay)
    );
  }

  @keyframes step-blinds-open {
    from { transform: scaleY(1); }
    to { transform: scaleY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .presentation-step-fly {
      transform: none;
    }

    .presentation-step-blinds .step-blinds-slat {
      transform: scaleY(0);
      animation: none;
    }
  }
</style>

<script>
  const initializedSteps = new WeakSet<HTMLElement>();

  function notifyIfVisible(step: HTMLElement): void {
    if (!step.hasAttribute("data-visible")) return;
    step.dispatchEvent(new CustomEvent("presentation-step-visible", { bubbles: true }));
  }

  function initPresentationSteps(): void {
    document.querySelectorAll<HTMLElement>(".presentation-step").forEach((step) => {
      if (initializedSteps.has(step)) return;
      initializedSteps.add(step);
      notifyIfVisible(step);
      new MutationObserver(() => notifyIfVisible(step)).observe(step, {
        attributes: true,
        attributeFilter: ["data-visible"],
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPresentationSteps, { once: true });
  } else {
    initPresentationSteps();
  }
  document.addEventListener("astro:page-load", initPresentationSteps);
</script>
