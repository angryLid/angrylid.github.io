---
// ============================================================================
// PresAsPost — lazy-loading iframe into the "presentation as document" page
// ============================================================================
// The actual deck rendering lives at /pres/[slug]/document/ (a dedicated page,
// see src/pages/pres/[slug]/document.astro). We must NOT render the slides
// inline here: this component is used inside an MDX blog post, and Astro only
// bundles the scoped <style> of a content-collection entry when it is rendered
// from a *page*. Rendering the slides from a component nested inside another
// MDX entry would silently drop every slide component's styles
// (withastro/astro#6121, withastro/astro#7761).
//
// By moving the rendering to its own page (like presenter.astro does), Astro
// bundles all the slide styles correctly there. This component then just
// embeds that page in a lazy-loading <iframe>: the iframe keeps its real `src`
// off until it scrolls near the viewport (IntersectionObserver + native
// loading="lazy"), so the deck isn't fetched until the reader reaches it.
// ============================================================================

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const asPostUrl = `/pres/${slug}/document/`;
---

<div class="pres-post">
  <p class="pres-post-intro">
    <a class="pres-post-fresh" href={asPostUrl}>在新窗口打开 ↗</a>
    <span class="pres-post-caption">滚动浏览全部幻灯片与讲者备注</span>
  </p>

  <div class="pres-embed" data-pres-embed>
    <iframe
      class="pres-iframe"
      title="演示文稿"
      src="about:blank"
      data-src={asPostUrl}
      loading="lazy"
      referrerpolicy="no-referrer"
    ></iframe>
    <noscript>
      <iframe
        class="pres-iframe"
        title="演示文稿"
        src={asPostUrl}
        referrerpolicy="no-referrer"
      ></iframe>
    </noscript>
  </div>
</div>

<style is:global>
  .pres-post {
    margin: 2rem 0;
  }

  .pres-post-intro {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .pres-post-intro a {
    color: var(--dark-mint);
    text-decoration: none;
  }
  .pres-post-intro a:hover {
    text-decoration: underline;
  }
  .pres-post-caption {
    color: var(--gray);
    opacity: 0.7;
  }

  /* Fixed-height embed holding the scrollable document page. */
  .pres-embed {
    position: relative;
    width: 100%;
    height: min(70vh, 720px);
    min-height: 480px;
    background: var(--light-gray);
    border-radius: var(--border-radius);
    border: 1px solid #e0e0d8;
    overflow: hidden;
  }
  .pres-iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  // Lazy-load: only give the iframe its real src once it scrolls near the
  // viewport. The <iframe> starts as about:blank so the blog page doesn't
  // fetch the (heavier) deck page until the reader reaches it.
  const embeds = document.querySelectorAll<HTMLElement>(
    "[data-pres-embed]",
  );
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const embed = entry.target as HTMLElement;
        const frame = embed.querySelector("iframe");
        if (frame && frame.getAttribute("src") === "about:blank") {
          frame.setAttribute("src", frame.getAttribute("data-src") ?? "");
        }
        io.unobserve(embed);
      }
    },
    { rootMargin: "400px 0px" },
  );
  embeds.forEach((embed) => io.observe(embed));
</script>