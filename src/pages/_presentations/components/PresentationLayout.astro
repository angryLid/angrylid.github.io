---
interface Props {
  title: string;
  /** @deprecated No longer rendered; the deck breadcrumb now carries section
   * context. Kept in the type so existing slide call sites still typecheck. */
  eyebrow?: string;
  /** Narrow mode: adds horizontal padding so content doesn't span the full slide width */
  narrow?: boolean;
  /** Reverse mode: puts the title at the bottom of the slide instead of the top */
  reverse?: boolean;
}

const { title, narrow = false, reverse = false } = Astro.props;
---

<section
  class:list={[
    "layout",
    { "is-narrow": narrow, "is-reverse": reverse },
  ]}
>
  <header class="head">
    <h1>{title}</h1>
  </header>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .layout {
    width: 100%;
    height: 100%;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    color: #333;
  }

  /* Narrow mode: constrain content width via horizontal padding */
  .is-narrow {
    padding-inline: 4rem;
  }

  /* Reverse mode: flip the column so the title sits at the bottom */
  .is-reverse {
    flex-direction: column-reverse;
  }

  .head {
    flex: 0 0 auto;
    padding: 0;
    text-align: center;
  }

  .head h1 {
    margin: 0;
    color: #333;
    font-family: "Noto Serif SC", "Songti SC", "SimSun", serif;
    font-size: 2.7rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .body {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }
</style>
