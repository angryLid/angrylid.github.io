---
interface Props {
  title: string;
  eyebrow?: string;
  /** Narrow mode: adds horizontal padding so content doesn't span the full slide width */
  narrow?: boolean;
  /** Reverse mode: puts the title at the bottom of the slide instead of the top */
  reverse?: boolean;
}

const { title, eyebrow, narrow = false, reverse = false } = Astro.props;
---

<section
  class:list={[
    "layout",
    { "is-narrow": narrow, "is-reverse": reverse },
  ]}
>
  <header class="head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
  </header>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .layout {
    width: 100%;
    height: 100%;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    color: #333;
  }

  /* Narrow mode: constrain content width via horizontal padding */
  .is-narrow {
    padding-inline: 4rem;
  }

  /* Reverse mode: flip the column so the title sits at the bottom */
  .is-reverse {
    flex-direction: column-reverse;
  }

  /* 1fr auto 1fr keeps the auto title column dead-center no matter how wide the
     eyebrow is; the eyebrow fills column 1, right-aligned so the text hugs the
     title's left edge, and baseline alignment seats both on the same bottom line */
  .head {
    flex: 0 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    column-gap: 0.75rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0;
    color: #9ca3af;
    font-family: "Cascadia Code", monospace;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    text-align: right;
  }

  .head h1 {
    grid-column: 2;
    margin: 0;
    color: #333;
    font-family: "Noto Serif SC", "Songti SC", "SimSun", serif;
    font-size: 2.7rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .body {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }
</style>
