---
import { ClientRouter } from "astro:transitions";
import PresHead from "@pres/components/PresHead.astro";
import SlideMindMap from "@pres/components/SlideMindMap.astro";
import type { MenuSlide } from "@pres/lib/pres-menu";

interface Props {
  slug: string;
  pageNo: number;
  total: number;
  steps: number;
  deckTitle: string;
  /** Section titles from the deck tree leading to this slide. */
  crumbs: string[];
  title: string;
  /** Deck metadata for the sorter menu's mind map. */
  slides: MenuSlide[];
}

const { slug, pageNo, total, steps, deckTitle, crumbs, title, slides } = Astro.props;
const fullTitle = `${deckTitle} — ${title} (${pageNo}/${total})`;
---

<!doctype html>
<html lang="en">
  <PresHead title={fullTitle}>
    <ClientRouter />
  </PresHead>

  <style is:global>
    html,
    body {
      height: 100%;
      overflow: hidden;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* 16:9 stage — largest 16/9 rectangle that fits the viewport */
      .slide-stage {
        width: min(100vw, calc(100vh * 16 / 9));
        aspect-ratio: 16 / 9;
        position: relative;
        overflow: hidden;
      }

      /* Fixed 1280×720 design canvas, scaled to fit the stage.
         position:absolute also establishes the positioning context for
         slide-content position:absolute (e.g. reveal answers). */
      .slide-inner {
        width: 1280px;
        height: 720px;
        transform-origin: top left;
        transform: scale(var(--s, 1));
        position: absolute;
        top: 0;
        left: 0;
      }

      /* Slide-level indicator (bottom-right) */
      .pres-indicator {
        position: fixed;
        right: 1rem;
        bottom: 0.75rem;
        font-size: 0.8rem;
        color: var(--gray);
        opacity: 0.6;
        font-family: "Cascadia Code", monospace;
      }

      /* Breadcrumb (top-left): deckTitle / section… / slide title. Pointer-events
         none so it never blocks the stage; below the menu overlay z-index. */
      .pres-breadcrumb {
        position: fixed;
        top: 0.75rem;
        left: 1rem;
        font-size: 0.8rem;
        font-family: "Cascadia Code", monospace;
        color: var(--gray);
        opacity: 0.6;
        z-index: 50;
        pointer-events: none;
        white-space: nowrap;
        max-width: calc(100vw - 2rem);
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .pres-breadcrumb .crumb + .crumb::before {
        content: "/";
        margin: 0 0.45em;
        opacity: 0.7;
      }
      .pres-breadcrumb .crumb[data-current] {
        color: var(--dark-mint);
      }

      /* ============================ Slide menu ============================ */
      /* Full-screen slide sorter, hidden by default, toggled with the `g` key.
         The overlay itself is the dim backdrop (translucent gray) so the stage
         stays faintly visible; the tree lives in a centered panel. */
      .pres-sidebar {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: rgba(72, 72, 72, 0.55);
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.28s ease,
          visibility 0.28s;
      }
      .pres-sidebar[data-open] {
        opacity: 1;
        visibility: visible;
      }
      .menu-panel {
        width: min(900px, 92vw);
        max-height: calc(100vh - 8vh);
        margin: 4vh 0;
        background: var(--white);
        border-radius: var(--border-radius);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .sidebar-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.9rem 1rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        flex: none;
      }
      .sidebar-title {
        font-weight: 600;
        color: var(--dark-mint);
        font-size: 0.95rem;
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sidebar-close {
        border: none;
        background: transparent;
        font-size: 1.1rem;
        line-height: 1;
        color: var(--gray);
        cursor: pointer;
        padding: 0.25rem 0.4rem;
        border-radius: var(--border-radius);
      }
      .sidebar-close:hover {
        background: rgba(0, 0, 0, 0.06);
      }
      .menu-scroll {
        flex: 1;
        overflow: auto;
        padding: 0.75rem;
      }
      /* Mind-map nodes/branches/connectors (.mm-*) are styled globally in
         SlideMindMap.astro — they render across that component and the
         recursive MindMapBranch. */
    </style>
  <body
    data-slug={slug}
    data-page-no={String(pageNo)}
    data-total={String(total)}
    data-steps={String(steps)}
    data-step="0"
  >
    <div class="slide-stage">
      <div class="slide-inner">
        <main class="slide">
          <slot />
        </main>
      </div>
    </div>
    <div class="pres-indicator">{pageNo} / {total}</div>
    <nav class="pres-breadcrumb" aria-label="Breadcrumb">
      {[deckTitle, ...crumbs, title].map((seg, i, arr) => (
        <span class="crumb" data-current={i === arr.length - 1 ? "" : undefined}>
          {seg}
        </span>
      ))}
    </nav>

    <div class="pres-sidebar" id="pres-sidebar" aria-label="Slide navigation" aria-hidden="true">
      <div class="menu-panel">
        <div class="sidebar-header">
          <span class="sidebar-title">{deckTitle}</span>
          <button type="button" class="sidebar-close" id="sidebar-close" aria-label="Close menu">
            ✕
          </button>
        </div>
        <div class="menu-scroll">
          <SlideMindMap deckTitle={deckTitle} slides={slides} current={pageNo} />
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  import { navigate } from "astro:transitions/client";
  import { prefetch } from "astro:prefetch";
  import {
    computeSteps as computeSharedSteps,
    syncVisibility,
  } from "@pres/lib/pres-visibility";

  // ---------------- BroadcastChannel (module scope; survives swaps) ----------------
  // Syncs the main slide window with the presenter-view popup. BC does not echo
  // back to the sender, so broadcasting on local action + applying silently on
  // receive cannot loop.
  const channel = new BroadcastChannel("pres-speaker");
  let navigatingTo: number | null = null; // destination pageNo during in-flight navigate
  let pendingStep: number | null = null; // step to apply once that page loads
  let navSource: "local" | "sync" | null = null; // who triggered the in-flight navigate

  function currentSlug(): string {
    return document.body.dataset.slug ?? "";
  }
  function readState() {
    const b = document.body;
    return {
      slug: b.dataset.slug ?? "",
      pageNo: parseInt(b.dataset.pageNo ?? "", 10),
      step: parseInt(b.dataset.step ?? "0", 10),
      total: parseInt(b.dataset.total ?? "0", 10),
    };
  }
  function broadcastState(): void {
    const s = readState();
    if (!s.slug) return;
    channel.postMessage({ kind: "state", ...s });
  }

  channel.onmessage = (e: MessageEvent) => {
    const msg = e.data;
    if (!msg || msg.slug !== currentSlug()) return;
    if (msg.kind === "request-state") {
      broadcastState();
      return;
    }
    if (msg.kind !== "state") return;
    const body = document.body;
    if (!body.dataset.slug) return;
    const myPage = parseInt(body.dataset.pageNo ?? "", 10);
    if (navigatingTo != null) {
      // mid-navigate: only remember the destination step, ignore the rest
      if (msg.pageNo === navigatingTo) pendingStep = msg.step;
      return;
    }
    if (msg.pageNo !== myPage) {
      navigatingTo = msg.pageNo;
      navSource = "sync";
      pendingStep = msg.step;
      navigate(`/pres/${currentSlug()}/live/${msg.pageNo}/`);
    } else {
      setStep(msg.step); // silent apply, no re-broadcast
    }
  };

  // ---------------- neighbor prefetch ----------------
  // The page-turn navigate() is a cold WAN roundtrip unless the target document
  // is already in the HTTP cache; warm the ±1 neighbors after each page load.
  // astro:prefetch keeps the data-saver / slow-connection safeguards.
  function prefetchNeighbors(): void {
    const body = document.body;
    const slug = body.dataset.slug;
    if (!slug) return;
    const pageNo = parseInt(body.dataset.pageNo ?? "", 10);
    const total = parseInt(body.dataset.total ?? "", 10);
    if (pageNo + 1 <= total) void prefetch(`/pres/${slug}/live/${pageNo + 1}/`);
    if (pageNo - 1 >= 1) void prefetch(`/pres/${slug}/live/${pageNo - 1}/`);
  }

  // ---------------- slide helpers ----------------
  // Step/visibility logic must stay scoped to the stage slide — the sorter
  // menu renders only labels, but keeping the scope also guards against any
  // future off-stage markup carrying data-anim attributes.
  function currentSlide(): HTMLElement | null {
    return document.querySelector(".slide-stage .slide");
  }

  function computeSteps(root: HTMLElement): number {
    const frontmatterSteps = parseInt(document.body.dataset.steps ?? "", 10);
    return computeSharedSteps(root, frontmatterSteps);
  }

  function setStep(step: number): void {
    const body = document.body;
    body.dataset.step = String(step);
    const slide = currentSlide();
    if (slide) syncVisibility(slide, step);
  }

  function goNext(): void {
    const body = document.body;
    const pageNo = parseInt(body.dataset.pageNo ?? "", 10);
    const total = parseInt(body.dataset.total ?? "", 10);
    const steps = computeSteps(currentSlide() ?? body);
    const step = parseInt(body.dataset.step ?? "0", 10);
    if (step < steps - 1) {
      setStep(step + 1);
      broadcastState();
    } else if (pageNo < total) {
      navigatingTo = pageNo + 1;
      navSource = "local";
      pendingStep = null;
      navigate(`/pres/${currentSlug()}/live/${pageNo + 1}/`);
    }
  }

  function goPrev(): void {
    const body = document.body;
    const pageNo = parseInt(body.dataset.pageNo ?? "", 10);
    const step = parseInt(body.dataset.step ?? "0", 10);
    if (step > 0) {
      setStep(step - 1);
      broadcastState();
    } else if (pageNo > 1) {
      // own-keyboard back-nav: same-window restore flag still works
      sessionStorage.setItem(
        `pres-restore-${currentSlug()}-${pageNo - 1}`,
        "last",
      );
      navigatingTo = pageNo - 1;
      navSource = "local";
      pendingStep = null;
      navigate(`/pres/${currentSlug()}/live/${pageNo - 1}/`);
    }
  }

  function openPresenter(): void {
    const s = readState();
    if (!s.slug) return;
    window.open(
      `/pres/${s.slug}/speaker/?page=${s.pageNo}`,
      "pres-speaker",
      "width=1280,height=800",
    );
  }

  // ---------------- sidebar (slide sorter) ----------------
  const sidebarStateKey = (slug: string) => `pres-sidebar-${slug}`;

  function getSidebar(): HTMLElement | null {
    return document.getElementById("pres-sidebar");
  }

  function openSidebar(): void {
    const sb = getSidebar();
    if (sb) {
      sb.setAttribute("data-open", "");
      sb.setAttribute("aria-hidden", "false");
      sb.querySelector(".mm-leaf[data-current]")?.scrollIntoView({
        block: "center",
        inline: "center",
      });
    }
    sessionStorage.setItem(sidebarStateKey(currentSlug()), "1");
  }

  function closeSidebar(): void {
    const sb = getSidebar();
    if (sb) {
      sb.removeAttribute("data-open");
      sb.setAttribute("aria-hidden", "true");
    }
    sessionStorage.removeItem(sidebarStateKey(currentSlug()));
  }

  function toggleSidebar(): void {
    const sb = getSidebar();
    if (sb && sb.hasAttribute("data-open")) closeSidebar();
    else openSidebar();
  }

  function initSidebar(): void {
    const sb = getSidebar();
    if (!sb) return;

    // Restore open/closed state across view-transition navigations.
    if (sessionStorage.getItem(sidebarStateKey(currentSlug())) === "1") {
      sb.setAttribute("data-open", "");
      sb.setAttribute("aria-hidden", "false");
      sb.querySelector(".mm-leaf[data-current]")?.scrollIntoView({
        block: "center",
        inline: "center",
      });
    }

    sb.querySelector("#sidebar-close")?.addEventListener("click", closeSidebar);

    // Clicking the dim backdrop (anywhere outside the panel) closes the menu.
    sb.addEventListener("click", (e) => {
      if (e.target === sb) closeSidebar();
    });


    sb.querySelectorAll(".mm-leaf").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = parseInt(btn.getAttribute("data-page") ?? "", 10);
        if (Number.isNaN(p)) return;
        const cur = parseInt(document.body.dataset.pageNo ?? "", 10);
        if (p === cur) {
          closeSidebar();
          return;
        }
        // Selecting a slide closes the drawer (drops the open-state so it
        // won't reopen on the target page), then navigates there.
        closeSidebar();
        navigatingTo = p;
        navSource = "local";
        pendingStep = null;
        navigate(`/pres/${currentSlug()}/live/${p}/`);
      });
    });
  }

  function initSlide(): void {
    const body = document.body;
    if (!body.dataset.slug) return;

    const slug = body.dataset.slug;
    const pageNo = parseInt(body.dataset.pageNo ?? "", 10);
    const steps = computeSteps(currentSlide() ?? body);

    let step = 0;
    // Back-nav restore (own-keyboard): previous page set the flag → land on last step.
    const restoreKey = `pres-restore-${slug}-${pageNo}`;
    if (sessionStorage.getItem(restoreKey) === "last") {
      step = steps - 1;
      sessionStorage.removeItem(restoreKey);
    }

    // Sync-driven navigation overrides the step with the carried pendingStep.
    const wasNav = navigatingTo === pageNo;
    const source = navSource;
    if (wasNav) {
      navigatingTo = null;
      navSource = null;
    }
    if (wasNav && pendingStep != null) {
      step = pendingStep;
      pendingStep = null;
    }

    body.dataset.step = String(step);
    const slide = currentSlide();
    if (slide) syncVisibility(slide, step);

    // Only broadcast for local navigations; sync navigations stay silent.
    if (wasNav && source === "local") broadcastState();
  }

  function onKeyDown(e: KeyboardEvent): void {
    const body = document.body;
    if (!body.dataset.slug) return;

    // Shift+Enter toggles fullscreen on the presentation.
    if (e.key === "Enter" && e.shiftKey) {
      e.preventDefault();
      if (document.fullscreenElement) {
        void document.exitFullscreen();
      } else {
        void document.documentElement.requestFullscreen().catch(() => {});
      }
      return;
    }

    // Shift+S opens the presenter-view popup.
    if (e.key === "S" && e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      openPresenter();
      return;
    }

    // `g` toggles the sidebar slide sorter (g for gallery).
    if (e.key === "g" && !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      toggleSidebar();
      return;
    }

    // Escape closes the sidebar if it is open.
    if (e.key === "Escape") {
      const sb = getSidebar();
      if (sb && sb.hasAttribute("data-open")) {
        e.preventDefault();
        closeSidebar();
        return;
      }
    }

    if (e.key === "ArrowRight" || e.key === "ArrowDown") {
      e.preventDefault();
      goNext();
    } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
      e.preventDefault();
      goPrev();
    }
  }

  // ---------------- slide canvas scaling ----------------
  // Scale the fixed 1280×720 design canvas to fit the .slide-stage.
  // Observer is disconnected on each view-transition swap to avoid leaks.
  let scaleRO: ResizeObserver | null = null;

  function initScale(): void {
    if (scaleRO) {
      scaleRO.disconnect();
      scaleRO = null;
    }
    const stage = document.querySelector(
      ".slide-stage",
    ) as HTMLElement | null;
    const inner = stage?.querySelector(
      ".slide-inner",
    ) as HTMLElement | null;
    if (!stage || !inner) return;
    const update = () =>
      inner.style.setProperty("--s", String(stage.clientWidth / 1280));
    update();
    scaleRO = new ResizeObserver(update);
    scaleRO.observe(stage);
  }

  // Bundled module script runs once per session. document persists across
  // view-transition swaps, so these listeners survive all navigations without
  // accumulating. astro:page-load re-initializes per page using fresh body data.
  document.addEventListener("astro:page-load", () => {
    initSlide();
    initScale();
    initSidebar();
    prefetchNeighbors();
  });
  document.addEventListener("keydown", onKeyDown);
</script>
