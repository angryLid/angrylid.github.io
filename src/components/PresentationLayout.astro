---
interface Props {
  title: string;
  eyebrow?: string;
  /** Narrow mode: adds horizontal padding so content doesn't span the full slide width */
  narrow?: boolean;
}

const { title, eyebrow, narrow = false } = Astro.props;
const layoutClass = narrow
  ? "presentation-layout presentation-layout--narrow"
  : "presentation-layout";
---

<section class={layoutClass}>
  <header class="presentation-layout__header">
    {eyebrow && <p class="presentation-layout__eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
  </header>
  <div class="presentation-layout__body">
    <slot />
  </div>
</section>

<style>
  .presentation-layout {
    width: 100%;
    height: 100%;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    color: #333;
  }

  /* Narrow mode: constrain content width via horizontal padding */
  .presentation-layout--narrow {
    padding-inline: 4rem;
  }

  .presentation-layout__header {
    position: relative;
    flex: 0 0 auto;
    padding: 0;
    text-align: center;
  }

  /* Eyebrow sits out of flow, floating above the title */
  .presentation-layout__eyebrow {
    position: absolute;
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    color: var(--dark-mint, #228b22);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .presentation-layout h1 {
    margin: 0;
    color: #333;
    font-size: 2.7rem;
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .presentation-layout__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }
</style>
