---
interface Props {
  title: string;
  eyebrow?: string;
  /** Narrow mode: adds horizontal padding so content doesn't span the full slide width */
  narrow?: boolean;
  /** Reverse mode: puts the title at the bottom of the slide instead of the top */
  reverse?: boolean;
}

const { title, eyebrow, narrow = false, reverse = false } = Astro.props;
---

<section
  class:list={[
    "layout",
    { "is-narrow": narrow, "is-reverse": reverse },
  ]}
>
  <header class="head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
  </header>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .layout {
    width: 100%;
    height: 100%;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    color: #333;
  }

  /* Narrow mode: constrain content width via horizontal padding */
  .is-narrow {
    padding-inline: 4rem;
  }

  /* Reverse mode: flip the column so the title sits at the bottom */
  .is-reverse {
    flex-direction: column-reverse;
  }

  .head {
    position: relative;
    flex: 0 0 auto;
    padding: 0;
    text-align: center;
  }

  /* Eyebrow sits out of flow, floating above the title */
  .eyebrow {
    position: absolute;
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    color: var(--dark-mint, #228b22);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .head h1 {
    margin: 0;
    color: #333;
    font-size: 2.7rem;
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .body {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }
</style>
