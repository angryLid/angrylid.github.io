---
/**
 * A reusable horizontal blinds entrance effect.
 *
 * The slot is deliberately opaque to this component: the effect covers the
 * bounds of whatever component or markup is placed inside it.
 */
interface Props {
  /** Number of horizontal slats. Default 16. */
  strips?: number;
  /** Duration of one slat's animation, in seconds. Default 0.8. */
  duration?: number;
  /** Delay before the animation starts, in seconds. Default 0. */
  delay?: number;
  /** Delay between consecutive slats, in seconds. Default 0.06. */
  stagger?: number;
  /** Slat fill colour. Default #ffffff. */
  slatColor?: string;
}

const {
  strips = 16,
  duration = 0.8,
  delay = 0,
  stagger = 0.06,
  slatColor = "var(--light-gray, #fafaf7)",
} = Astro.props;

const slatCount = Math.max(1, Math.floor(strips));
const slats = Array.from({ length: slatCount }, (_, i) => i);
---

<div
  class="blinds"
  style={`--blinds-duration:${duration}s;--blinds-delay:${delay}s;--blinds-stagger:${stagger}s;--blinds-slat-color:${slatColor};`}
>
  <slot />
  <div class="blinds-mask" aria-hidden="true">
    {slats.map((i) => <span class="blinds-slat" style={`--i:${i};`} />)}
  </div>
</div>

<style>
  .blinds {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    min-width: 0;
    min-height: 0;
    overflow: visible;
  }

  .blinds-mask {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .blinds-slat {
    flex: 1 1 0;
    /* Match the presentation/page canvas by default, rather than assuming
       white. Consumers can still override this with slatColor. */
    background: var(--blinds-slat-color, var(--light-gray, #fafaf7));
    transform-origin: center;
    transform: scaleY(1);
  }

  .blinds.is-playing .blinds-slat {
    animation: blinds-open var(--blinds-duration, 0.8s) ease forwards;
    animation-delay: calc(
      var(--i, 0) * var(--blinds-stagger, 0.06s) + var(--blinds-delay, 0s)
    );
  }

  @keyframes blinds-open {
    from { transform: scaleY(1); }
    to { transform: scaleY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .blinds-slat { transform: scaleY(0); }
    .blinds.is-playing .blinds-slat { animation: none; }
  }
</style>

<script>
  function play(blinds: HTMLElement): void {
    blinds.classList.add("is-playing");
  }

  function setup(): void {
    document.querySelectorAll<HTMLElement>(".blinds").forEach((blinds) => {
      if (blinds.closest(".presentation-step")) return;
      play(blinds);
    });
  }

  document.addEventListener("astro:page-load", setup);
  document.addEventListener("presentation-step-visible", (event) => {
    (event.target as Element).querySelectorAll<HTMLElement>(".blinds").forEach(play);
  });
</script>
