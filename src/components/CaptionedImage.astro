---
/**
 * CaptionedImage.astro
 *
 * An image wrapper that renders a caption above, below, or inside an image.
 * Entrance effects are intentionally composed outside this component, for
 * example through the `PresentationStep` effect strategy.
 *
 * Images are passed by `src` (the existing slide pattern:
 * `import img from "./assets/x.png"; <CaptionedImage src={img.src} ... />`).
 *
 * The inside caption is positioned by a small measurement script so it
 * follows the rendered image rather than a letterboxed media area.
 */

interface Props {
  /** Image source, e.g. an imported asset's `.src`. */
  src: string;
  /** Alt text for the image. */
  alt: string;
  /** Text label rendered for the image. Multi-line: pass a string array
   *  (each element becomes its own line) or a string containing literal
   *  "\\n". Long lines wrap naturally (white-space: pre-line). */
  caption?: string | string[];
  /** Caption placement: "above" renders the label above the image (default);
   *  "below" renders it directly below the image; "inside" overlays it at the
   *  bottom-centre of the image. Multi-line captions are supported: long text
   *  wraps naturally, and a literal "\\n" in the caption becomes a line break
   *  (white-space: pre-line). */
  captionPosition?: "above" | "below" | "inside";
  /** Alignment of this component as an item in its parent grid/flex layout. */
  alignSelf?: "flex-start" | "flex-end" | "center" | "stretch";
}

const {
  src,
  alt,
  caption,
  captionPosition = "above",
  alignSelf,
} = Astro.props;

const captionText = Array.isArray(caption) ? caption.join("\n") : caption;
const captionLines = captionText?.split("\n") ?? [];
---

<figure
  class="captioned-image"
  data-caption-position={captionPosition}
  style={alignSelf ? { alignSelf } : undefined}
>
  {captionText && (captionPosition === "above" || captionPosition === "below") && (
    <figcaption class:list={["ci-caption", { "ci-caption-below": captionPosition === "below" }]}>
      {captionLines.map((line, index) =>
        index === 0 ? (
          <strong class="ci-caption-line ci-caption-title">{line}</strong>
        ) : (
          <span class="ci-caption-line">{line}</span>
        )
      )}
    </figcaption>
  )}
  <div class="ci-media">
    <img src={src} alt={alt} class="ci-img" loading="eager" decoding="async" />
    {
      captionText && captionPosition === "inside" && (
        <figcaption class="ci-caption-inside">
          {captionLines.map((line, index) =>
            index === 0 ? (
              <strong class="ci-caption-line ci-caption-title">{line}</strong>
            ) : (
              <span class="ci-caption-line">{line}</span>
            )
          )}
        </figcaption>
      )
    }
  </div>
</figure>

<style>
  .captioned-image {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    min-height: 0;
    margin: 0;
    gap: 0.8rem;
  }

  .ci-caption {
    flex-shrink: 0;
    text-align: center;
    font-size: 1.5rem;
    color: #333;
    font-weight: 600;
    line-height: 1.3;
    /* Multi-line captions (string array / "\n"): each line gets its own
       row; long lines wrap naturally. */
    white-space: pre-line;
  }

  .ci-caption-below {
    order: 1;
    font-size: 1rem;
  }

  .ci-caption-line {
    display: block;
    font-weight: 400;
  }

  .ci-caption-title {
    font-family: "Noto Serif CJK SC", "Songti SC", "SimSun", serif;
    font-weight: 900;
  }

  /* "inside" placement: the box is sized by the init script to exactly match
     the image's rendered rect, so the label sits at
     the bottom-centre OF THE IMAGE even when the image is letterboxed inside
     the media area. The text is pre-line: it wraps naturally and "\n" in the
     caption string becomes a line break. */
  .ci-caption-inside {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    box-sizing: border-box;
    max-width: 100%;
    margin: 0;
    padding: 0.15rem 0.5rem 0.3rem;
    overflow: hidden;
    pointer-events: none;
    text-align: center;
    font-size: 1rem;
    color: #333;
    font-weight: 600;
    line-height: 1.4;
    white-space: pre-line;
    background: #fff;
  }

  /* The media area is a plain flex centre. The image fits itself via
     max-width/max-height + object-fit:contain. */
  .ci-media {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ci-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .ci-caption-inside { transition: none; }
  }
</style>

<script>
  function sizeCaption(ci: Element): void {
    const img = ci.querySelector<HTMLImageElement>(".ci-img");
    const caption = ci.querySelector<HTMLElement>(".ci-caption-inside");
    const media = ci.querySelector<HTMLElement>(".ci-media");
    if (!img || !caption || !media || !img.complete || !img.naturalWidth) return;
    const imageRect = img.getBoundingClientRect();
    const mediaRect = media.getBoundingClientRect();
    caption.style.left = `${imageRect.left - mediaRect.left}px`;
    caption.style.top = `${imageRect.top - mediaRect.top}px`;
    caption.style.width = `${imageRect.width}px`;
    caption.style.height = `${imageRect.height}px`;
  }

  function setup(ci: Element): void {
    const img = ci.querySelector<HTMLImageElement>(".ci-img");
    const media = ci.querySelector<HTMLElement>(".ci-media");
    if (!img || !media) return;
    const measure = (): void => sizeCaption(ci);
    img.addEventListener("load", measure, { once: true });
    new ResizeObserver(measure).observe(media);
    measure();
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll(".captioned-image").forEach(setup);
  });
</script>
