---
import { ClientRouter } from "astro:transitions";
import PresHead from "@components/PresHead.astro";

interface SlideThumb {
  Content: any;
  title: string;
  pageNo: number;
}

interface Props {
  slug: string;
  pageNo: number;
  total: number;
  steps: number;
  presTitle: string;
  title: string;
  slides: SlideThumb[];
}

const { slug, pageNo, total, steps, presTitle, title, slides } = Astro.props;
const fullTitle = `${presTitle} — ${title} (${pageNo}/${total})`;
---

<!doctype html>
<html lang="en">
  <PresHead title={fullTitle}>
    <ClientRouter />
  </PresHead>

  <style is:global>
    html,
    body {
      height: 100%;
      overflow: hidden;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* 16:9 stage — largest 16/9 rectangle that fits the viewport */
      .slide-stage {
        width: min(100vw, calc(100vh * 16 / 9));
        aspect-ratio: 16 / 9;
        position: relative;
        overflow: hidden;
      }

      /* Fixed 1280×720 design canvas, scaled to fit the stage.
         position:absolute also establishes the positioning context for
         slide-content position:absolute (e.g. reveal answers). */
      .slide-inner {
        width: 1280px;
        height: 720px;
        transform-origin: top left;
        transform: scale(var(--s, 1));
        position: absolute;
        top: 0;
        left: 0;
      }

      /* Slide-level indicator (bottom-right) */
      .pres-indicator {
        position: fixed;
        right: 1rem;
        bottom: 0.75rem;
        font-size: 0.8rem;
        color: var(--gray);
        opacity: 0.6;
        font-family: "Cascadia Code", monospace;
      }

      /* ============================ Sidebar ============================ */
      /* Slide-sorter drawer, hidden by default, toggled with the `g` key. */
      /* Scrim / mask behind the drawer — dims the stage so the drawer reads
         as a proper modal overlay. */
      .pres-scrim {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.28s ease,
          visibility 0.28s;
        z-index: 90;
      }
      .pres-sidebar[data-open] ~ .pres-scrim {
        opacity: 1;
        visibility: visible;
      }
      .pres-sidebar {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        width: min(340px, 84vw);
        background: var(--white);
        border-right: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 4px 0 16px rgba(0, 0, 0, 0.12);
        z-index: 100;
        display: flex;
        flex-direction: column;
        transform: translateX(-100%);
        visibility: hidden;
        transition:
          transform 0.28s ease,
          visibility 0.28s;
      }
      .pres-sidebar[data-open] {
        transform: translateX(0);
        visibility: visible;
      }
      .sidebar-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.9rem 1rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        flex: none;
      }
      .sidebar-title {
        font-weight: 600;
        color: var(--dark-mint);
        font-size: 0.95rem;
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sidebar-close {
        border: none;
        background: transparent;
        font-size: 1.1rem;
        line-height: 1;
        color: var(--gray);
        cursor: pointer;
        padding: 0.25rem 0.4rem;
        border-radius: var(--border-radius);
      }
      .sidebar-close:hover {
        background: rgba(0, 0, 0, 0.06);
      }
      .sidebar-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .sidebar-item {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        text-align: left;
        border: none;
        background: transparent;
        padding: 0.4rem;
        border-radius: var(--border-radius);
        cursor: pointer;
        font: inherit;
        color: var(--gray);
      }
      .sidebar-item:hover {
        background: rgba(0, 0, 0, 0.05);
      }
      .sidebar-item[data-current] {
        background: rgba(34, 139, 34, 0.1);
        outline: 2px solid var(--dark-mint);
      }
      .item-num {
        flex: none;
        width: 1.6rem;
        height: 1.6rem;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--light-gray);
        border: 1px solid rgba(0, 0, 0, 0.12);
        font-size: 0.75rem;
        font-family: "Cascadia Code", monospace;
      }
      .sidebar-item[data-current] .item-num {
        background: var(--dark-mint);
        color: var(--white);
        border-color: var(--dark-mint);
      }
      .item-thumb {
        flex: none;
      }
      .item-thumb .preview-stage {
        width: 150px;
      }
      .item-title {
        font-size: 0.85rem;
        line-height: 1.3;
        padding-top: 0.15rem;
        flex: 1;
      }
      /* thumbnail scaling — faithful miniature of the 1280x720 design */
      .preview-stage {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--light-gray);
        border-radius: 6px;
        border: 1px solid rgba(0, 0, 0, 0.08);
      }
      .preview-inner {
        width: 1280px;
        height: 720px;
        transform-origin: top left;
        transform: scale(var(--s, 1));
        position: absolute;
        top: 0;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--light-gray);
      }
    </style>
  <body
    data-slug={slug}
    data-page-no={String(pageNo)}
    data-total={String(total)}
    data-steps={String(steps)}
    data-step="0"
  >
    <div class="slide-stage">
      <div class="slide-inner">
        <main class="slide">
          <slot />
        </main>
      </div>
    </div>
    <div class="pres-indicator">{pageNo} / {total}</div>

    <div class="pres-sidebar" id="pres-sidebar" aria-label="Slide navigation" aria-hidden="true">
      <div class="sidebar-header">
        <span class="sidebar-title">{presTitle}</span>
        <button type="button" class="sidebar-close" id="sidebar-close" aria-label="Close sidebar">
          ✕
        </button>
      </div>
      <div class="sidebar-scroll">
        {
          slides.map(({ Content, title, pageNo: p }) => (
            <button
              type="button"
              class="sidebar-item"
              data-page={p}
              data-current={pageNo === p ? "" : undefined}
            >
              <span class="item-num">{p}</span>
              <span class="item-thumb preview-stage">
                <span class="preview-inner">
                  <main class="slide"><Content /></main>
                </span>
              </span>
              <span class="item-title">{title}</span>
            </button>
          ))
        }
      </div>
    </div>
    <div class="pres-scrim" id="pres-scrim"></div>
  </body>
</html>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    computeSteps as computeSharedSteps,
    syncVisibility,
  } from "../utils/pres-visibility";

  // ---------------- BroadcastChannel (module scope; survives swaps) ----------------
  // Syncs the main slide window with the presenter-view popup. BC does not echo
  // back to the sender, so broadcasting on local action + applying silently on
  // receive cannot loop.
  const channel = new BroadcastChannel("pres-speaker");
  let navigatingTo: number | null = null; // destination pageNo during in-flight navigate
  let pendingStep: number | null = null; // step to apply once that page loads
  let navSource: "local" | "sync" | null = null; // who triggered the in-flight navigate

  function currentSlug(): string {
    return document.body.dataset.slug ?? "";
  }
  function readState() {
    const b = document.body;
    return {
      slug: b.dataset.slug ?? "",
      pageNo: parseInt(b.dataset.pageNo ?? "", 10),
      step: parseInt(b.dataset.step ?? "0", 10),
      total: parseInt(b.dataset.total ?? "0", 10),
    };
  }
  function broadcastState(): void {
    const s = readState();
    if (!s.slug) return;
    channel.postMessage({ kind: "state", ...s });
  }

  channel.onmessage = (e: MessageEvent) => {
    const msg = e.data;
    if (!msg || msg.slug !== currentSlug()) return;
    if (msg.kind === "request-state") {
      broadcastState();
      return;
    }
    if (msg.kind !== "state") return;
    const body = document.body;
    if (!body.dataset.slug) return;
    const myPage = parseInt(body.dataset.pageNo ?? "", 10);
    if (navigatingTo != null) {
      // mid-navigate: only remember the destination step, ignore the rest
      if (msg.pageNo === navigatingTo) pendingStep = msg.step;
      return;
    }
    if (msg.pageNo !== myPage) {
      navigatingTo = msg.pageNo;
      navSource = "sync";
      pendingStep = msg.step;
      navigate(`/pres/${currentSlug()}/live/${msg.pageNo}/`);
    } else {
      setStep(msg.step); // silent apply, no re-broadcast
    }
  };

  // ---------------- slide helpers ----------------
  // The audience slide lives inside .slide-stage. The sidebar drawer also
  // renders every slide in the deck as off-canvas thumbnails, so we must scope
  // step/visibility logic to the stage slide only — otherwise data-anim elements
  // from all slides pollute the step count and make page turns feel sluggish.
  function currentSlide(): HTMLElement | null {
    return document.querySelector(".slide-stage .slide");
  }

  function computeSteps(root: HTMLElement): number {
    const frontmatterSteps = parseInt(document.body.dataset.steps ?? "", 10);
    return computeSharedSteps(root, frontmatterSteps);
  }

  function setStep(step: number): void {
    const body = document.body;
    body.dataset.step = String(step);
    const slide = currentSlide();
    if (slide) syncVisibility(slide, step);
  }

  function goNext(): void {
    const body = document.body;
    const pageNo = parseInt(body.dataset.pageNo ?? "", 10);
    const total = parseInt(body.dataset.total ?? "", 10);
    const steps = computeSteps(currentSlide() ?? body);
    const step = parseInt(body.dataset.step ?? "0", 10);
    if (step < steps - 1) {
      setStep(step + 1);
      broadcastState();
    } else if (pageNo < total) {
      navigatingTo = pageNo + 1;
      navSource = "local";
      pendingStep = null;
      navigate(`/pres/${currentSlug()}/live/${pageNo + 1}/`);
    }
  }

  function goPrev(): void {
    const body = document.body;
    const pageNo = parseInt(body.dataset.pageNo ?? "", 10);
    const step = parseInt(body.dataset.step ?? "0", 10);
    if (step > 0) {
      setStep(step - 1);
      broadcastState();
    } else if (pageNo > 1) {
      // own-keyboard back-nav: same-window restore flag still works
      sessionStorage.setItem(
        `pres-restore-${currentSlug()}-${pageNo - 1}`,
        "last",
      );
      navigatingTo = pageNo - 1;
      navSource = "local";
      pendingStep = null;
      navigate(`/pres/${currentSlug()}/live/${pageNo - 1}/`);
    }
  }

  function openPresenter(): void {
    const s = readState();
    if (!s.slug) return;
    window.open(
      `/pres/${s.slug}/speaker/?page=${s.pageNo}`,
      "pres-speaker",
      "width=1280,height=800",
    );
  }

  // ---------------- sidebar (slide sorter) ----------------
  const sidebarStateKey = (slug: string) => `pres-sidebar-${slug}`;

  function getSidebar(): HTMLElement | null {
    return document.getElementById("pres-sidebar");
  }

  function scaleSidebarThumbs(): void {
    document
      .querySelectorAll(".pres-sidebar .preview-stage")
      .forEach((stage) => {
        const inner = stage.querySelector(
          ".preview-inner",
        ) as HTMLElement | null;
        if (inner)
          inner.style.setProperty("--s", String(stage.clientWidth / 1280));
      });
  }

  function openSidebar(): void {
    const sb = getSidebar();
    if (sb) {
      sb.setAttribute("data-open", "");
      sb.setAttribute("aria-hidden", "false");
      sb.querySelector(".sidebar-item[data-current]")?.scrollIntoView({
        block: "nearest",
      });
    }
    sessionStorage.setItem(sidebarStateKey(currentSlug()), "1");
  }

  function closeSidebar(): void {
    const sb = getSidebar();
    if (sb) {
      sb.removeAttribute("data-open");
      sb.setAttribute("aria-hidden", "true");
    }
    sessionStorage.removeItem(sidebarStateKey(currentSlug()));
  }

  function toggleSidebar(): void {
    const sb = getSidebar();
    if (sb && sb.hasAttribute("data-open")) closeSidebar();
    else openSidebar();
  }

  function initSidebar(): void {
    const sb = getSidebar();
    if (!sb) return;

    // Restore open/closed state across view-transition navigations.
    if (sessionStorage.getItem(sidebarStateKey(currentSlug())) === "1") {
      sb.setAttribute("data-open", "");
      sb.setAttribute("aria-hidden", "false");
      sb.querySelector(".sidebar-item[data-current]")?.scrollIntoView({
        block: "nearest",
      });
    }

    // Show all animation steps in each thumbnail for a complete preview.
    sb.querySelectorAll(".preview-stage [data-anim]").forEach((el) => {
      el.setAttribute("data-visible", "");
    });

    // Rescale thumbnails to their container width (sidebar is resizable via vw).
    const ro = new ResizeObserver(() => scaleSidebarThumbs());
    sb.querySelectorAll(".preview-stage").forEach((s) => ro.observe(s));
    scaleSidebarThumbs();

    sb.querySelector("#sidebar-close")?.addEventListener("click", closeSidebar);

    // Clicking the scrim/mask closes the drawer.
    document.getElementById("pres-scrim")?.addEventListener("click", closeSidebar);


    sb.querySelectorAll(".sidebar-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = parseInt(btn.getAttribute("data-page") ?? "", 10);
        if (Number.isNaN(p)) return;
        const cur = parseInt(document.body.dataset.pageNo ?? "", 10);
        if (p === cur) {
          closeSidebar();
          return;
        }
        // Selecting a slide closes the drawer (drops the open-state so it
        // won't reopen on the target page), then navigates there.
        closeSidebar();
        navigatingTo = p;
        navSource = "local";
        pendingStep = null;
        navigate(`/pres/${currentSlug()}/live/${p}/`);
      });
    });
  }

  function initSlide(): void {
    const body = document.body;
    if (!body.dataset.slug) return;

    const slug = body.dataset.slug;
    const pageNo = parseInt(body.dataset.pageNo ?? "", 10);
    const steps = computeSteps(currentSlide() ?? body);

    let step = 0;
    // Back-nav restore (own-keyboard): previous page set the flag → land on last step.
    const restoreKey = `pres-restore-${slug}-${pageNo}`;
    if (sessionStorage.getItem(restoreKey) === "last") {
      step = steps - 1;
      sessionStorage.removeItem(restoreKey);
    }

    // Sync-driven navigation overrides the step with the carried pendingStep.
    const wasNav = navigatingTo === pageNo;
    const source = navSource;
    if (wasNav) {
      navigatingTo = null;
      navSource = null;
    }
    if (wasNav && pendingStep != null) {
      step = pendingStep;
      pendingStep = null;
    }

    body.dataset.step = String(step);
    const slide = currentSlide();
    if (slide) syncVisibility(slide, step);

    // Only broadcast for local navigations; sync navigations stay silent.
    if (wasNav && source === "local") broadcastState();
  }

  function onKeyDown(e: KeyboardEvent): void {
    const body = document.body;
    if (!body.dataset.slug) return;

    // Shift+Enter toggles fullscreen on the presentation.
    if (e.key === "Enter" && e.shiftKey) {
      e.preventDefault();
      if (document.fullscreenElement) {
        void document.exitFullscreen();
      } else {
        void document.documentElement.requestFullscreen().catch(() => {});
      }
      return;
    }

    // Shift+S opens the presenter-view popup.
    if (e.key === "S" && e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      openPresenter();
      return;
    }

    // `g` toggles the sidebar slide sorter (g for gallery).
    if (e.key === "g" && !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      toggleSidebar();
      return;
    }

    // Escape closes the sidebar if it is open.
    if (e.key === "Escape") {
      const sb = getSidebar();
      if (sb && sb.hasAttribute("data-open")) {
        e.preventDefault();
        closeSidebar();
        return;
      }
    }

    if (e.key === "ArrowRight" || e.key === "ArrowDown") {
      e.preventDefault();
      goNext();
    } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
      e.preventDefault();
      goPrev();
    }
  }

  // ---------------- slide canvas scaling ----------------
  // Scale the fixed 1280×720 design canvas to fit the .slide-stage.
  // Observer is disconnected on each view-transition swap to avoid leaks.
  let scaleRO: ResizeObserver | null = null;

  function initScale(): void {
    if (scaleRO) {
      scaleRO.disconnect();
      scaleRO = null;
    }
    const stage = document.querySelector(
      ".slide-stage",
    ) as HTMLElement | null;
    const inner = stage?.querySelector(
      ".slide-inner",
    ) as HTMLElement | null;
    if (!stage || !inner) return;
    const update = () =>
      inner.style.setProperty("--s", String(stage.clientWidth / 1280));
    update();
    scaleRO = new ResizeObserver(update);
    scaleRO.observe(stage);
  }

  // Bundled module script runs once per session. document persists across
  // view-transition swaps, so these listeners survive all navigations without
  // accumulating. astro:page-load re-initializes per page using fresh body data.
  document.addEventListener("astro:page-load", () => {
    initSlide();
    initScale();
    initSidebar();
  });
  document.addEventListener("keydown", onKeyDown);
</script>
